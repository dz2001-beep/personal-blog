---
import { formatDate } from '../utils/format';
import type { Post } from '../lib/db';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, tags, slug } = post;
const searchText = `${title} ${description} ${tags.join(' ')}`.toLowerCase();
---

<article class="post-card reveal" data-search={searchText}>
  <a href={`/blog/${slug}/`} class="post-card-link">
    <div class="post-meta">
      <span class="post-date">
        <time datetime={post.created_at}>{formatDate(new Date(post.created_at))}</time>
        <span class="post-views">👁 {post.views}</span>
      </span>
      {
        tags.length > 0 && (
          <span class="post-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </span>
        )
      }
    </div>
    <h3 class="post-title">{title}</h3>
    <p class="post-desc">{description}</p>
    <span class="post-more">阅读全文 →</span>
  </a>
</article>

<style>
  .post-card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 22px;
    transition: all 0.2s ease;
  }

  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .post-card-link {
    color: inherit;
    display: block;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    margin-bottom: 10px;
  }

  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .post-views {
    color: var(--text-faint);
  }

  .post-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .post-title {
    margin: 0 0 8px;
    font-size: 1.2rem;
  }

  .post-desc {
    margin: 0 0 14px;
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .post-card:hover .post-more {
    transform: translateX(4px);
  }
</style>
