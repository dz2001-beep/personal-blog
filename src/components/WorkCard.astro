---
import { formatDate } from '../utils/format';
import type { Work } from '../lib/db';

interface Props {
  work: Work;
}

const { work } = Astro.props;
const { title, description, tech, slug, demo_url, repo_url } = work;
---

<article class="work-card reveal">
  <a href={`/works/${slug}/`} class="work-card-link">
    <div class="work-head">
      <span class="work-dots">
        <i></i><i></i><i></i>
      </span>
      <span class="work-date">{formatDate(new Date(work.created_at))}</span>
    </div>
    <h3 class="work-title">{title}</h3>
    <p class="work-desc">{description}</p>
    {
      tech.length > 0 && (
        <div class="work-tech">
          {tech.map((t) => <span class="tag">{t}</span>)}
        </div>
      )
    }
  </a>
  <div class="work-links">
    {demo_url && <a class="btn btn-primary" href={demo_url} target="_blank" rel="noopener">在线演示</a>}
    {repo_url && <a class="btn" href={repo_url} target="_blank" rel="noopener">源码</a>}
  </div>
</article>

<style>
  .work-card {
    position: relative;
    background: var(--glass-gradient), var(--glass-solid);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.24s ease, transform 0.24s ease, box-shadow 0.24s ease;
    overflow: hidden;
  }

  /* 右上角折角(dog-ear);柔光占用 ::after,这里用 ::before */
  .work-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 22px;
    height: 22px;
    background: linear-gradient(
      225deg,
      color-mix(in srgb, var(--accent) 85%, #fff) 0 40%,
      var(--accent) 40% 48%,
      color-mix(in srgb, var(--accent) 35%, #000) 48% 54%,
      transparent 54%
    );
    opacity: 0.6;
    transition: width 0.24s ease, height 0.24s ease, opacity 0.24s ease;
    pointer-events: none;
    z-index: 2;
  }

  .work-card:hover::before {
    width: 30px;
    height: 30px;
    opacity: 0.9;
  }

  /* 卡片右上角的柔光,给扁平卡片一点层次 */
  .work-card::after {
    content: '';
    position: absolute;
    top: -60px;
    right: -50px;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.09), transparent 70%);
    pointer-events: none;
    transition: opacity 0.3s ease;
    opacity: 0.7;
  }

  .work-card:hover::after {
    opacity: 1;
  }

  .work-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.36);
  }

  .work-card-link {
    color: inherit;
  }

  .work-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  /* 仿代码编辑器窗口的三色点 */
  .work-dots {
    display: flex;
    gap: 5px;
  }

  .work-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--red);
    opacity: 0.9;
  }

  .work-dots i:nth-child(2) {
    background: var(--yellow);
  }

  .work-dots i:nth-child(3) {
    background: var(--green);
  }

  .work-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .work-title {
    margin: 0 0 8px;
    font-size: 1.15rem;
  }

  .work-desc {
    margin: 0 0 12px;
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-tech {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .work-links {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .work-links .btn {
    padding: 6px 14px;
    font-size: 0.82rem;
  }
</style>
