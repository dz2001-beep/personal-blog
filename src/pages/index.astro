---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import Sidebar from '../components/Sidebar.astro';
import { getSiteConfig } from '../lib/db';
import { COVER_IMAGE } from '../config';

const site = getSiteConfig();

const socialButtons = [
  { href: site.social.github, label: 'GitHub', show: !!site.social.github },
  { href: site.social.juejin, label: '掘金', show: !!site.social.juejin },
  { href: site.social.twitter, label: 'Twitter', show: !!site.social.twitter },
  { href: site.social.email ? `mailto:${site.social.email}` : '', label: 'Email', show: !!site.social.email },
].filter((s) => s.show);
---

<BaseLayout>
  <!-- ============ 全屏封面 ============ -->
  <section class="cover" id="cover">
    <div class="cover-bg" style={`background-image:url('${COVER_IMAGE}')`}></div>
    <div class="cover-mask"></div>

    <div class="cover-inner">
      <div class="cover-avatar">
        <Avatar size={120} alt={`${site.author} 的头像`} src={site.avatar} fallback={site.avatar} />
      </div>
      <h1 class="cover-title">{site.author}</h1>
      <p class="cover-sub">{site.heroTagline}</p>
      <p class="cover-desc">{site.description}</p>
      <div class="cover-actions">
        <a class="cover-link" href="/blog">阅读文章</a>
        <span class="cover-sep">/</span>
        <a class="cover-link" href="/works">查看作品</a>
      </div>
      {
        socialButtons.length > 0 && (
          <div class="cover-social">
            {socialButtons.map((s) => (
              <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
            ))}
          </div>
        )
      }
    </div>

    <!-- 向下滚动提示 -->
    <a class="scroll-hint" href="#intro" aria-label="向下滚动查看自我介绍">
      <span class="mouse"><span class="wheel"></span></span>
      <span class="scroll-text">向下滚动</span>
    </a>
  </section>

  <!-- ============ 自我介绍 + 侧栏 ============ -->
  <section class="intro-section" id="intro">
    <div class="container-wide">
      <div class="layout-two">
        <div class="layout-main">
          <p class="intro-kicker">// 自我介绍</p>
          <p class="intro-text">{site.homeIntro}</p>
          <div class="intro-links">
            <a href="/about">关于我</a>
            <span>·</span>
            <a href="/blog">技术文章</a>
            <span>·</span>
            <a href="/works">开源作品</a>
            <span>·</span>
            <a href="/gallery">生活相册</a>
          </div>
        </div>

        <Sidebar />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============ 全屏封面 ============ */
  .cover {
    position: relative;
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cover-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    animation: coverZoom 1.6s ease-out both;
    will-change: transform;
  }

  .cover-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 20, 30, 0.34) 0%,
      rgba(15, 20, 30, 0.5) 60%,
      rgba(247, 248, 250, 0.96) 100%
    );
  }

  .cover-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 40px 20px 90px;
    animation: coverContentIn 1s ease 0.25s both;
  }

  .cover-avatar {
    display: inline-block;
    margin-bottom: 20px;
    animation: avatarFloat 3.4s ease-in-out infinite alternate;
  }

  :global(.cover-avatar .avatar) {
    border-color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.16), 0 12px 30px rgba(0, 0, 0, 0.32);
  }

  .cover-title {
    margin: 0 0 10px;
    font-size: 3.2rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #fff;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.42);
  }

  .cover-sub {
    margin: 0 0 12px;
    font-size: 1.05rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.38);
  }

  .cover-desc {
    margin: 0 auto 24px;
    max-width: 540px;
    font-size: 0.94rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.84);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.38);
  }

  .cover-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    color: rgba(255, 255, 255, 0.7);
  }

  .cover-link {
    color: rgba(255, 255, 255, 0.95);
    font-size: 0.94rem;
    font-weight: 600;
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    padding-bottom: 2px;
    transition: all 0.18s ease;
  }

  .cover-link:hover {
    color: #fff;
    border-color: #fff;
  }

  .cover-sep {
    opacity: 0.5;
  }

  .cover-social {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-top: 18px;
    flex-wrap: wrap;
  }

  .cover-social a {
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .cover-social a:hover {
    color: #fff;
  }

  /* 向下滚动提示 */
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #fff;
    animation: hintFloat 2.2s ease-in-out infinite;
  }

  .mouse {
    width: 24px;
    height: 38px;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 13px;
    position: relative;
    display: block;
  }

  .wheel {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 4px;
    height: 7px;
    margin-left: -2px;
    border-radius: 2px;
    background: #fff;
    animation: wheelMove 1.6s ease-in-out infinite;
  }

  .scroll-text {
    font-size: 0.74rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }

  @keyframes coverZoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  @keyframes coverContentIn {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes hintFloat {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, -8px); }
  }

  @keyframes wheelMove {
    0% { opacity: 0; transform: translateY(0); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(14px); }
  }

  /* ============ 自我介绍区 ============ */
  .intro-section {
    padding: 60px 0 40px;
    margin-top: -70px;
    position: relative;
    z-index: 3;
    background: linear-gradient(180deg, transparent 0%, var(--bg) 70px);
  }

  .intro-kicker {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .intro-text {
    margin: 0 0 22px;
    font-size: 1.05rem;
    line-height: 2;
    color: var(--text);
    max-width: 640px;
  }

  .intro-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 0.9rem;
    color: var(--text-faint);
  }

  .intro-links a {
    color: var(--text-dim);
  }

  .intro-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .cover {
      min-height: calc(100vh - 56px);
    }
    .cover-bg {
      background-attachment: scroll;
    }
    .cover-title {
      font-size: 2.1rem;
    }
    .cover-inner {
      padding: 24px 16px 80px;
    }
    :global(.cover-avatar .avatar) {
      width: 96px !important;
      height: 96px !important;
    }
    .intro-text {
      font-size: 0.95rem;
      line-height: 1.9;
    }
  }
</style>
