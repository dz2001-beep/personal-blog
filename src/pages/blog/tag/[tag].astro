---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts } from '../../../lib/db';

const tag = Astro.params.tag || '';
const posts = getPublishedPosts().filter((p) => p.tags.includes(tag));
const allTags = [...new Set(getPublishedPosts().flatMap((p) => p.tags))].sort();
---

<BaseLayout title={`标签:${tag}`} description={`标签「${tag}」下的全部文章`}>
  <section class="container-wide">
    <header class="page-head fade-up">
      <h1>标签:<span class="accent-tag">{tag}</span></h1>
      <p>共 {posts.length} 篇文章</p>
    </header>

    <!-- 全部标签导航 -->
    <div class="tag-filter">
      <a href="/blog" class="tag filter-tag">全部</a>
      {
        allTags.map((t) => (
          <a
            href={`/blog/tag/${encodeURIComponent(t)}/`}
            class:list={['tag', 'filter-tag', { active: t === tag }]}
          >
            {t}
          </a>
        ))
      }
    </div>

    {
      posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="empty">该标签下暂时没有文章。</p>
      )
    }

    <div class="section-more">
      <a class="btn" href="/blog">← 返回全部文章</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 48px 0 8px;
  }

  .page-head h1 {
    margin: 0 0 6px;
    font-size: 2.2rem;
  }

  .page-head p {
    margin: 0;
    color: var(--text-dim);
  }

  .accent-tag {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .tag-filter {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 22px 0 26px;
  }

  .filter-tag {
    padding: 4px 14px;
    font-size: 0.8rem;
  }

  .filter-tag:hover,
  .filter-tag.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 40px;
  }

  .empty {
    color: var(--text-dim);
    padding: 40px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: center;
  }

  .section-more {
    text-align: center;
    margin-bottom: 60px;
  }
</style>
