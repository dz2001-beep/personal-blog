---
/**
 * 厨房列表页
 *
 * 交互设计(核心要求:点开不跳页、不来回返回)
 * - 桌面端:左侧列表 + 右侧常驻详情面板,点卡片只切换右侧内容,URL 用 replaceState 同步
 * - 移动端:同一个面板变成底部抽屉,点卡片弹出、下滑或点关闭收起
 * - 每张卡片仍是真链接,JS 不可用 / 分享 / 直链时可打开 /kitchen/[slug]/ 独立页
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mascot from '../../components/Mascot.astro';
import DishCard from '../../components/DishCard.astro';
import DishDetail from '../../components/DishDetail.astro';
import { DISHES, hasCover } from '../../data/kitchen';

const cookedCount = DISHES.filter((d) => d.type === 'cooked').length;
const wishCount = DISHES.filter((d) => d.type === 'wish').length;
---

<BaseLayout
  title="下厨"
  description="做饭研究笔记:做过的记下翻车与改良,想学的先记着为什么想做。"
  bgImage="/gallery/sunset-field.jpg"
  bgTint="rgba(226, 178, 132, 0.18)"
>
  <section class="container-wide kitchen-page">
    <header class="page-head fade-up">
      <span class="page-kicker">Kitchen</span>
      <h1>下厨</h1>
      <p>研究做饭的地方。做过的记下翻车和改良,想学的先记着为什么想做——做成之后就从右边搬到左边。</p>
      <Mascot />
    </header>

    <div class="kitchen-layout">
      {/* ---------------- 左:列表 ---------------- */}
      <div class="kitchen-list-col">
        <div class="kitchen-filters" role="group" aria-label="筛选">
          <button type="button" class="filter-chip is-active" data-filter="all">
            全部 <b>{DISHES.length}</b>
          </button>
          <button type="button" class="filter-chip" data-filter="cooked">
            做过的 <b>{cookedCount}</b>
          </button>
          <button type="button" class="filter-chip" data-filter="wish">
            想学的 <b>{wishCount}</b>
          </button>
          <span class="filter-hint">点开不跳页,右侧直接看</span>
        </div>

        {
          DISHES.length > 0 ? (
            <div class="kitchen-list" data-dish-list>
              {DISHES.map((dish) => (
                <DishCard dish={dish} />
              ))}
            </div>
          ) : (
            <p class="kitchen-empty">
              还没有菜品。在 <code>src/data/kitchen.ts</code> 里加一道菜,照片放进 <code>public/kitchen/</code>。
            </p>
          )
        }
      </div>

      {/* ---------------- 右:详情面板 / 移动端抽屉 ---------------- */}
      <aside class="kitchen-panel" data-dish-panel aria-label="菜品详情" aria-live="polite">
        <div class="sheet-handle" data-sheet-handle aria-hidden="true"><span /></div>

        <div class="panel-toolbar">
          <div class="panel-nav">
            <button type="button" class="panel-btn" data-dish-prev aria-label="上一道">←</button>
            <span class="panel-count" data-dish-count>—</span>
            <button type="button" class="panel-btn" data-dish-next aria-label="下一道">→</button>
          </div>
          <button type="button" class="panel-btn panel-close" data-dish-close aria-label="收起详情">✕</button>
        </div>

        <div class="panel-scroll" data-dish-scroll>
          <div class="panel-placeholder" data-dish-placeholder>
            <span class="panel-placeholder-glyph" aria-hidden="true">◍</span>
            <p>点左边的菜,这里直接展开</p>
            <small>不跳页、不开新窗口,看完接着往下翻</small>
          </div>

          {
            DISHES.map((dish) => (
              <div class="panel-dish" data-dish-detail data-dish-slug={dish.slug} hidden>
                <DishDetail dish={dish} hero={hasCover(dish)} />
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </section>

  {/* 移动端抽屉背后的遮罩 */}
  <div class="sheet-backdrop" data-sheet-backdrop hidden />
</BaseLayout>

<script>
  import '../../scripts/kitchen';
</script>

<style>
  .kitchen-page {
    padding-bottom: 40px;
  }

  .kitchen-layout {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    margin-top: 4px;
  }

  /* ---------------- 筛选 ---------------- */
  .kitchen-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .filter-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font: inherit;
    font-size: 0.78rem;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-dim);
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .filter-chip b {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    color: var(--text-faint);
  }

  .filter-chip:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .filter-chip.is-active {
    color: #f0d9bd;
    border-color: rgba(226, 178, 132, 0.5);
    background: rgba(226, 178, 132, 0.12);
  }

  .filter-chip.is-active b {
    color: #e2b284;
  }

  .filter-hint {
    margin-left: auto;
    font-size: 0.68rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
  }

  /* ---------------- 列表 ---------------- */
  .kitchen-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: calc(100vh - 210px);
    overflow-y: auto;
    padding-right: 4px;
    overscroll-behavior: contain;
  }

  .kitchen-list::-webkit-scrollbar {
    width: 5px;
  }

  .kitchen-list::-webkit-scrollbar-thumb {
    background: #39424f;
    border-radius: 3px;
  }

  .kitchen-empty {
    padding: 24px;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--text-faint);
    font-size: 0.82rem;
  }

  .kitchen-empty code {
    color: var(--text-dim);
  }

  /* ---------------- 详情面板 ---------------- */
  .kitchen-panel {
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 108px);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--glass-gradient), var(--glass-solid);
    backdrop-filter: blur(12px);
    overflow: hidden;
  }

  .sheet-handle {
    display: none;
  }

  .panel-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .panel-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .panel-btn {
    font: inherit;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-dim);
    font-size: 0.76rem;
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .panel-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.11);
  }

  .panel-count {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
    min-width: 44px;
    text-align: center;
  }

  .panel-scroll {
    overflow-y: auto;
    padding: 18px 20px 24px;
    overscroll-behavior: contain;
  }

  .panel-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .panel-scroll::-webkit-scrollbar-thumb {
    background: #3a4452;
    border-radius: 3px;
  }

  /* 空状态 */
  .panel-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 320px;
    text-align: center;
    color: var(--text-faint);
  }

  .panel-placeholder-glyph {
    font-size: 2rem;
    color: rgba(226, 178, 132, 0.5);
    animation: pulseGlyph 3.4s ease-in-out infinite;
  }

  .panel-placeholder p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  .panel-placeholder small {
    font-size: 0.72rem;
  }

  @keyframes pulseGlyph {
    0%,
    100% {
      opacity: 0.45;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  /* 切换动画 */
  .panel-dish {
    animation: dishIn 0.28s ease both;
  }

  @keyframes dishIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .sheet-backdrop {
    display: none;
  }

  /* ---------------- 移动端:改成底部抽屉 ---------------- */
  @media (max-width: 1024px) {
    .kitchen-layout {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .kitchen-list {
      max-height: none;
      overflow: visible;
      padding-right: 0;
    }

    .kitchen-panel {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      max-height: 88vh;
      height: 88vh;
      border-radius: 18px 18px 0 0;
      border-bottom: 0;
      z-index: 320;
      transform: translateY(102%);
      transition: transform 0.34s cubic-bezier(0.22, 0.82, 0.28, 1);
      will-change: transform;
    }

    .kitchen-panel.is-open {
      transform: translateY(0);
    }

    .sheet-handle {
      display: flex;
      justify-content: center;
      padding: 8px 0 2px;
      cursor: grab;
      touch-action: none;
    }

    .sheet-handle span {
      width: 38px;
      height: 4px;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.22);
    }

    .sheet-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 310;
      background: rgba(8, 10, 14, 0.6);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .sheet-backdrop.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .sheet-backdrop[hidden] {
      display: none;
    }

    .filter-hint {
      display: none;
    }

    /* 抽屉打开时锁住背景滚动 */
    :global(html.sheet-open),
    :global(html.sheet-open body) {
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kitchen-panel,
    .panel-dish,
    .panel-placeholder-glyph {
      animation: none;
      transition: none;
    }
  }
</style>
