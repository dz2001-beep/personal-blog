---
/**
 * 菜品详情内容(瑞士国际主义风格)
 * 同时用于:列表页右侧常驻面板(桌面)、移动端抽屉、独立详情页 /kitchen/[slug]/
 *
 * 设计要点:白底 / 巨大标题 / 蓝色小方块标记 / 黑色发丝线分隔 / 无圆角无阴影无渐变
 */
import { coverOf, extraPhotosOf, type Dish } from '../data/kitchen';

interface Props {
  dish: Dish;
  /** 是否显示顶部的大图(面板里显示,独立页显示) */
  hero?: boolean;
  /** 标题尺寸:panel = 右侧面板里用;page = 独立页当主标题用 */
  variant?: 'panel' | 'page';
}

const { dish, hero = true, variant = 'panel' } = Astro.props;
const cover = coverOf(dish);
const extraPhotos = extraPhotosOf(dish);

const typeLabel = dish.type === 'cooked' ? '做过的' : '想学的';

const facts = [
  { label: '首次记录', value: dish.date },
  dish.attempts ? { label: '尝试次数', value: `第 ${dish.attempts} 次才成` } : null,
  dish.duration ? { label: '耗时', value: `约 ${dish.duration} 分钟` } : null,
  dish.difficulty ? { label: '难度', value: '●'.repeat(dish.difficulty) + '○'.repeat(5 - dish.difficulty) } : null,
  dish.rating ? { label: '我的评分', value: '★'.repeat(dish.rating) + '☆'.repeat(5 - dish.rating) } : null,
].filter(Boolean) as { label: string; value: string }[];
---

<div class:list={['dd', `dd--${variant}`]}>
  <!-- 类型标记 -->
  <div class="dd-type">
    <span class="sq" aria-hidden="true"></span>
    <span>{typeLabel}</span>
  </div>

  <!-- 标题 -->
  <h2 class="dd-title">{dish.name}</h2>
  {dish.tagline && <p class="dd-tagline">{dish.tagline}</p>}

  <!-- 大图:硬边矩形,无圆角 -->
  {
    hero && cover && (
      <figure class="dd-hero">
        <img src={cover} alt={dish.name} loading="lazy" decoding="async" />
      </figure>
    )
  }

  {
    extraPhotos.length > 0 && (
      <div class="dd-extra">
        {extraPhotos.map((src) => (
          <img src={src} alt={`${dish.name} 的另一张`} loading="lazy" decoding="async" />
        ))}
      </div>
    )
  }

  <!-- 数据条:发丝线网格 -->
  <dl class="dd-facts">
    {
      facts.map((f) => (
        <div class="dd-fact">
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
  </dl>

  {/* 想学的:为什么想学 */}
  {dish.reason?.trim() && (
    <section class="dd-sec">
      <h3 class="dd-sec-title"><span class="sq" aria-hidden="true" />为什么想学这道</h3>
      <p class="dd-text">{dish.reason}</p>
    </section>
  )}

  {/* 食材 */}
  {
    dish.ingredients && dish.ingredients.length > 0 && (
      <section class="dd-sec">
        <h3 class="dd-sec-title"><span class="sq" aria-hidden="true" />食材</h3>
        <ul class="dd-ing">
          {dish.ingredients.map((item) => (
            <li>
              <span class="ing-name">{item.name}</span>
              {item.amount && <span class="ing-amount">{item.amount}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* 做法 */}
  {
    dish.steps && dish.steps.length > 0 && (
      <section class="dd-sec">
        <h3 class="dd-sec-title"><span class="sq" aria-hidden="true" />做法</h3>
        <ol class="dd-steps">
          {dish.steps.map((step, i) => (
            <li class="dd-step">
              <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
              <div class="step-body">
                <p class="step-text">{step.text}</p>
                {step.minutes ? <span class="step-min">{step.minutes}′</span> : null}
                {step.tip ? <p class="step-tip">关键:{step.tip}</p> : null}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {/* 翻车记录 */}
  {
    dish.failures && dish.failures.length > 0 && (
      <section class="dd-sec">
        <h3 class="dd-sec-title"><span class="sq sq-dark" aria-hidden="true" />翻车记录</h3>
        <ul class="dd-fail">
          {dish.failures.map((f) => <li>{f}</li>)}
        </ul>
      </section>
    )
  }

  {/* 心得 */}
  {dish.note?.trim() && (
    <section class="dd-sec">
      <h3 class="dd-sec-title"><span class="sq" aria-hidden="true" />心得</h3>
      <p class="dd-text">{dish.note}</p>
    </section>
  )}

  {/* 结论:蓝色色块 */}
  {
    dish.verdict?.trim() && (
      <section class="dd-verdict">
        <span class="dd-verdict-label">结论</span>
        <p>{dish.verdict}</p>
      </section>
    )
  }

  <!-- 页脚 -->
  <footer class="dd-foot">
    <div class="dd-tags">
      {dish.tags.map((tag) => <span class="dd-tag">{tag}</span>)}
    </div>
    {dish.source && <p class="dd-source">图片来源:{dish.source}</p>}
  </footer>
</div>

<style>
  .dd {
    color: #0a0a0a;
  }

  /* ---------- 类型标记 ---------- */
  .dd-type {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6f6f6f;
  }

  /* 蓝色小方块:全页统一的强调标记 */
  .sq {
    display: inline-block;
    width: 9px;
    height: 9px;
    background: #1e40ff;
    flex: 0 0 auto;
  }

  .sq-dark {
    background: #0a0a0a;
  }

  /* ---------- 标题 ---------- */
  .dd-title {
    margin: 0;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: #0a0a0a;
  }

  /* 独立页:标题当主标题,字号拉到与页面 mega 一致 */
  .dd--page .dd-title {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .dd-tagline {
    margin: 10px 0 0;
    font-size: 0.94rem;
    line-height: 1.6;
    color: #565656;
  }

  /* ---------- 大图 ---------- */
  .dd-hero {
    margin: 20px 0 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #ededed;
    border: 1px solid #e0e0e0;
  }

  .dd-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .dd-extra {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 8px;
    margin-top: 8px;
  }

  .dd-extra img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border: 1px solid #e0e0e0;
  }

  /* ---------- 数据条 ---------- */
  .dd-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(108px, 1fr));
    margin: 22px 0 0;
    border-top: 2px solid #0a0a0a;
    border-bottom: 1px solid #e6e6e6;
  }

  .dd-fact {
    padding: 10px 12px 12px 0;
    border-right: 1px solid #ededed;
  }

  .dd-fact:last-child {
    border-right: 0;
  }

  .dd-fact dt {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9b9b9b;
    margin-bottom: 4px;
  }

  .dd-fact dd {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: #0a0a0a;
    letter-spacing: -0.01em;
  }

  /* ---------- 小节 ---------- */
  .dd-sec {
    margin-top: 28px;
  }

  .dd-sec-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e6e6e6;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #0a0a0a;
  }

  .dd-text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.9;
    color: #333;
  }

  /* ---------- 食材 ---------- */
  .dd-ing {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0 24px;
  }

  .dd-ing li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.86rem;
  }

  .ing-name {
    color: #0a0a0a;
  }

  .ing-amount {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #8d8d8d;
    text-align: right;
    white-space: nowrap;
  }

  /* ---------- 步骤 ---------- */
  .dd-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dd-step {
    display: flex;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .step-no {
    flex: 0 0 26px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: #1e40ff;
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }

  .step-body {
    min-width: 0;
    flex: 1;
  }

  .step-text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.75;
    color: #1a1a1a;
  }

  .step-min {
    display: inline-block;
    margin-top: 5px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: #9b9b9b;
  }

  .step-tip {
    margin: 8px 0 0;
    padding: 7px 10px;
    border-left: 2px solid #1e40ff;
    background: #f4f5ff;
    font-size: 0.78rem;
    line-height: 1.65;
    color: #2a2f4a;
  }

  /* ---------- 翻车记录 ---------- */
  .dd-fail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    border-left: 2px solid #0a0a0a;
  }

  .dd-fail li {
    padding: 9px 12px;
    background: #f7f7f7;
    font-size: 0.82rem;
    line-height: 1.7;
    color: #333;
  }

  /* ---------- 结论 ---------- */
  .dd-verdict {
    margin-top: 28px;
    padding: 16px 18px;
    background: #1e40ff;
    color: #fff;
  }

  .dd-verdict-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .dd-verdict p {
    margin: 6px 0 0;
    font-size: 0.92rem;
    line-height: 1.7;
    font-weight: 500;
  }

  /* ---------- 页脚 ---------- */
  .dd-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 24px;
    padding-top: 14px;
    border-top: 1px solid #e6e6e6;
  }

  .dd-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .dd-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border: 1px solid #dcdcdc;
    color: #6f6f6f;
  }

  .dd-source {
    margin: 0;
    font-size: 0.64rem;
    color: #9b9b9b;
  }
</style>
