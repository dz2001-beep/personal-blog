---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import Sidebar from '../components/Sidebar.astro';
import { getSiteConfig, getPublishedPosts, getFeaturedWorks, getAllWorks } from '../lib/db';
import { GALLERY } from '../data/gallery';
import { formatDate } from '../utils/format';
import { COVER_IMAGE, BODY_IMAGE } from '../config';

const site = getSiteConfig();
const allPosts = getPublishedPosts();
const allWorks = getAllWorks();
const posts = allPosts;
const works = getFeaturedWorks();

const firstPost = allPosts.length > 0 ? allPosts[allPosts.length - 1] : undefined;
const days = firstPost
  ? Math.max(1, Math.floor((Date.now() - new Date(firstPost.created_at).getTime()) / 86400000))
  : 0;

const socialButtons = [
  { href: site.social.github, label: 'GitHub', show: !!site.social.github },
  { href: site.social.juejin, label: '掘金', show: !!site.social.juejin },
  { href: site.social.twitter, label: 'Twitter', show: !!site.social.twitter },
  { href: site.social.email ? `mailto:${site.social.email}` : '', label: 'Email', show: !!site.social.email },
].filter((s) => s.show);
---

<BaseLayout>
  <!-- ============ 全屏封面 ============ -->
  <section class="cover" id="cover">
    <div class="cover-bg" style={`background-image:url('${COVER_IMAGE}')`}></div>
    <div class="cover-mask"></div>

    <div class="cover-inner">
      <div class="cover-avatar">
        <Avatar size={120} alt={`${site.author} 的头像`} src={site.avatar} fallback={site.avatar} />
      </div>
      <h1 class="cover-title">{site.author}</h1>
      <p class="cover-sub">{site.heroTagline}</p>
      <p class="cover-desc">{site.description}</p>
      <div class="cover-actions">
        <a class="cover-link" href="/blog">阅读文章</a>
        <span class="cover-sep">/</span>
        <a class="cover-link" href="/works">查看作品</a>
      </div>
      {
        socialButtons.length > 0 && (
          <div class="cover-social">
            {socialButtons.map((s) => (
              <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
            ))}
          </div>
        )
      }
    </div>

    <!-- 向下滚动提示 -->
    <a class="scroll-hint" href="#intro" aria-label="向下滚动查看自我介绍">
      <span class="mouse"><span class="wheel"></span></span>
      <span class="scroll-text">向下滚动</span>
    </a>
  </section>

  <!-- ============ 自我介绍 + 精选内容 + 侧栏 ============ -->
  <section class="intro-section" id="intro" style={`background-image: linear-gradient(rgba(18,22,29,0.88), rgba(18,22,29,0.94)), url('${BODY_IMAGE}')`}>
    <div class="container-wide">
      <div class="layout-two">
        <div class="layout-main">
          <!-- 自我介绍 -->
          <div class="block intro-head reveal" data-tilt>
            <p class="intro-kicker">// 自我介绍</p>
            <p class="intro-text">{site.homeIntro}</p>
            <div class="intro-stats">
              <span><b data-count={String(allPosts.length)}>{allPosts.length}</b> 篇文章</span>
              <span class="dot">·</span>
              <span><b data-count={String(allWorks.length)}>{allWorks.length}</b> 个作品</span>
              <span class="dot">·</span>
              <span><b data-count={String(GALLERY.length)}>{GALLERY.length}</b> 张照片</span>
              <span class="dot">·</span>
              <span>建站 <b data-count={String(days)}>{days}</b> 天</span>
            </div>
            <div class="intro-links">
              <a href="/about">关于我</a>
              <span>·</span>
              <a href="/blog">技术文章</a>
              <span>·</span>
              <a href="/works">开源作品</a>
              <span>·</span>
              <a href="/gallery">生活相册</a>
            </div>
          </div>

          <!-- 最近在写 -->
          {
            posts.length > 0 && (
              <section class="block mini-section reveal" data-tilt>
                <div class="mini-head">
                  <h2>最近在写</h2>
                  <a href="/blog">全部文章 →</a>
                </div>
                <ul class="post-mini-list">
                  {posts.slice(0, 3).map((p) => (
                    <li>
                      <a href={`/blog/${p.slug}/`}>
                        <span class="pm-title">{p.title}</span>
                        <span class="pm-meta">
                          {formatDate(new Date(p.created_at))} · {p.views} 浏览
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <!-- 做过的东西 -->
          {
            works.length > 0 && (
              <section class="block mini-section reveal" data-tilt>
                <div class="mini-head">
                  <h2>做过的东西</h2>
                  <a href="/works">全部作品 →</a>
                </div>
                <div class="work-mini-grid">
                  {works.slice(0, 2).map((w) => (
                    <a class="work-mini" href={`/works/${w.slug}/`}>
                      <span class="wm-title">{w.title}</span>
                      <span class="wm-desc">{w.description}</span>
                      <span class="wm-tech">{w.tech.slice(0, 3).join(' · ')}</span>
                    </a>
                  ))}
                </div>
              </section>
            )
          }

          <!-- 光影瞬间 -->
          <section class="block mini-section reveal" data-tilt>
            <div class="mini-head">
              <h2>光影瞬间</h2>
              <a href="/gallery">全部相册 →</a>
            </div>
            <div class="photo-mini-grid">
              {GALLERY.slice(0, 3).map((item) => (
                <a class="photo-mini" href="/gallery">
                  <img src={item.src} alt={item.title} loading="lazy" />
                  <span>{item.title}</span>
                </a>
              ))}
            </div>
          </section>
        </div>

        <Sidebar />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============ 全屏封面 ============ */
  .cover {
    position: relative;
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cover-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    animation: coverZoom 1.6s ease-out both;
    will-change: transform;
  }

  .cover-mask {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 20, 30, 0.34) 0%,
      rgba(15, 20, 30, 0.5) 60%,
      rgba(18, 22, 29, 0.97) 100%
    );
  }

  .cover-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 40px 20px 90px;
    animation: coverContentIn 1s ease 0.25s both;
  }

  .cover-avatar {
    display: inline-block;
    margin-bottom: 20px;
    animation: avatarFloat 3.4s ease-in-out infinite alternate;
  }

  :global(.cover-avatar .avatar) {
    border-color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.16), 0 12px 30px rgba(0, 0, 0, 0.32);
  }

  .cover-title {
    margin: 0 0 10px;
    font-size: 3.2rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #fff;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.42);
  }

  .cover-sub {
    margin: 0 0 12px;
    font-size: 1.05rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.38);
  }

  .cover-desc {
    margin: 0 auto 24px;
    max-width: 540px;
    font-size: 0.94rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.84);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.38);
  }

  .cover-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    color: rgba(255, 255, 255, 0.7);
  }

  .cover-link {
    color: rgba(255, 255, 255, 0.95);
    font-size: 0.94rem;
    font-weight: 600;
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    padding-bottom: 2px;
    transition: all 0.18s ease;
  }

  .cover-link:hover {
    color: #fff;
    border-color: #fff;
  }

  .cover-sep {
    opacity: 0.5;
  }

  .cover-social {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-top: 18px;
    flex-wrap: wrap;
  }

  .cover-social a {
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .cover-social a:hover {
    color: #fff;
  }

  /* 向下滚动提示 */
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #fff;
    animation: hintFloat 2.2s ease-in-out infinite;
  }

  .mouse {
    width: 24px;
    height: 38px;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 13px;
    position: relative;
    display: block;
  }

  .wheel {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 4px;
    height: 7px;
    margin-left: -2px;
    border-radius: 2px;
    background: #fff;
    animation: wheelMove 1.6s ease-in-out infinite;
  }

  .scroll-text {
    font-size: 0.74rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }

  @keyframes coverZoom {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }

  @keyframes coverContentIn {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes hintFloat {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, -8px); }
  }

  @keyframes wheelMove {
    0% { opacity: 0; transform: translateY(0); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(14px); }
  }

  /* ============ 自我介绍区 ============ */
  .intro-section {
    padding: 64px 0 54px;
    margin-top: -70px;
    position: relative;
    z-index: 3;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }

  /* 分块卡片(玻璃拟态 + 3D 倾斜 + 光扫) */
  .block {
    position: relative;
    background: rgba(255, 255, 255, 0.045);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 26px;
    margin-bottom: 18px;
    box-shadow: 0 2px 18px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* 悬停时玻璃高光扫过 */
  .block::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 32%,
      rgba(255, 255, 255, 0.55) 48%,
      transparent 64%
    );
    transform: translateX(-130%);
    transition: transform 0.75s ease;
    pointer-events: none;
    border-radius: inherit;
  }

  .block:hover::after {
    transform: translateX(130%);
  }

  .block:hover {
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.4);
  }

  /* 分块依次浮现(错峰) */
  .layout-main > .block:nth-child(1) {
    transition-delay: 0s;
  }

  .layout-main > .block:nth-child(2) {
    transition-delay: 0.08s;
  }

  .layout-main > .block:nth-child(3) {
    transition-delay: 0.16s;
  }

  .layout-main > .block:nth-child(4) {
    transition-delay: 0.24s;
  }

  .intro-kicker {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .intro-text {
    margin: 0 0 22px;
    font-size: 1.05rem;
    line-height: 2;
    color: var(--text);
    max-width: 640px;
  }

  .intro-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 0.9rem;
    color: var(--text-faint);
  }

  .intro-links a {
    color: var(--text-dim);
  }

  .intro-links a:hover {
    color: var(--accent);
  }

  /* ---------- 统计数据 ---------- */
  .intro-stats {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0 0 18px;
    font-size: 0.86rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .intro-stats b {
    color: var(--accent);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .intro-stats .dot {
    color: var(--text-faint);
  }

  /* ---------- 首页迷你板块 ---------- */
  .mini-section {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .mini-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .mini-head h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .mini-head a {
    font-size: 0.82rem;
    color: var(--text-faint);
  }

  .mini-head a:hover {
    color: var(--accent);
  }

  /* 最近在写:极简列表 */
  .post-mini-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-mini-list li + li {
    border-top: 1px dashed var(--border);
  }

  .post-mini-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 2px;
    color: var(--text);
  }

  .post-mini-list a:hover .pm-title {
    color: var(--accent);
  }

  .pm-title {
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.15s ease;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pm-meta {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-faint);
  }

  /* 做过的东西:两列 */
  .work-mini-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }

  .work-mini {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition: all 0.18s ease;
  }

  .work-mini:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    color: var(--text);
  }

  .wm-title {
    font-weight: 700;
    font-size: 0.98rem;
  }

  .wm-desc {
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .wm-tech {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-faint);
  }

  /* 光影瞬间:三列 */
  .photo-mini-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .photo-mini {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    aspect-ratio: 4 / 3;
    background: var(--bg-soft);
  }

  .photo-mini img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .photo-mini:hover img {
    transform: scale(1.06);
  }

  .photo-mini span {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 22px 10px 8px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
    color: #fff;
    font-size: 0.8rem;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .photo-mini:hover span {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .photo-mini-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .post-mini-list a {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
    }
    .pm-title {
      white-space: normal;
    }
  }

  @media (max-width: 640px) {
    .cover {
      min-height: calc(100vh - 56px);
    }
    .cover-bg {
      background-attachment: scroll;
    }
    .intro-section {
      background-attachment: scroll;
    }
    .cover-title {
      font-size: 2.1rem;
    }
    .cover-inner {
      padding: 24px 16px 80px;
    }
    :global(.cover-avatar .avatar) {
      width: 96px !important;
      height: 96px !important;
    }
    .intro-text {
      font-size: 0.95rem;
      line-height: 1.9;
    }
  }
</style>
