---
import { formatDate } from '../utils/format';
import type { Post } from '../lib/db';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, tags, slug } = post;
const searchText = `${title} ${description} ${tags.join(' ')}`.toLowerCase();
---

<article class="post-card reveal" data-search={searchText}>
  <a href={`/blog/${slug}/`} class="post-card-link">
    <div class="post-meta">
      <span class="post-date">
        <time datetime={post.created_at}>{formatDate(new Date(post.created_at))}</time>
        <span class="post-views">{post.views} 浏览</span>
      </span>
      {
        tags.length > 0 && (
          <span class="post-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </span>
        )
      }
    </div>
    <h3 class="post-title">{title}</h3>
    <p class="post-desc">{description}</p>
    <span class="post-more">阅读全文 →</span>
  </a>
</article>

<style>
  .post-card {
    position: relative;
    background: var(--glass-gradient), var(--glass-solid);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 22px;
    transition: border-color 0.24s ease, transform 0.24s ease, box-shadow 0.24s ease;
  }

  /* 顶部高光,和 panel 保持同一套视觉语言 */
  .post-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    border-radius: var(--radius) var(--radius) 0 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2) 45%, transparent);
    opacity: 0.65;
    pointer-events: none;
  }

  /* 右上角折角(dog-ear) */
  .post-card::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 22px;
    height: 22px;
    background: linear-gradient(
      225deg,
      color-mix(in srgb, var(--accent) 85%, #fff) 0 40%,
      var(--accent) 40% 48%,
      color-mix(in srgb, var(--accent) 35%, #000) 48% 54%,
      transparent 54%
    );
    opacity: 0.6;
    transition: width 0.24s ease, height 0.24s ease, opacity 0.24s ease;
    pointer-events: none;
  }

  .post-card:hover::after {
    width: 30px;
    height: 30px;
    opacity: 0.9;
  }

  .post-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.36);
  }

  .post-card-link {
    color: inherit;
    display: block;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    margin-bottom: 10px;
  }

  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .post-views {
    color: var(--text-faint);
  }

  .post-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .post-title {
    margin: 0 0 8px;
    font-size: 1.2rem;
  }

  .post-desc {
    margin: 0 0 14px;
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .post-card:hover .post-more {
    transform: translateX(4px);
  }
</style>
