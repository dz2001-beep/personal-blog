---
import '../styles/global.css';
import { getSiteConfig } from '../lib/db';

interface Props {
  title: string;
}

const { title } = Astro.props;
const site = getSiteConfig();
const { pathname } = Astro.url;
const username = Astro.locals.username ?? '';

const navItems = [
  { href: '/admin', label: '仪表盘', icon: '📊' },
  { href: '/admin/posts/new', label: '写文章', icon: '✍️' },
  { href: '/admin/works/new', label: '新作品', icon: '🚀' },
  { href: '/admin/settings', label: '设置', icon: '⚙️' },
];

function isActive(href: string): boolean {
  if (href === '/admin') return pathname === '/admin';
  return pathname.startsWith(href);
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · 后台 | {site.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="admin-body">
    <aside class="sidebar">
      <a href="/" class="side-brand">
        <span class="brand-mark">&lt;/&gt;</span>
        <span>管理后台</span>
      </a>
      <nav class="side-nav">
        {
          navItems.map((item) => (
            <a href={item.href} class:list={['side-link', { active: isActive(item.href) }]}>
              <span class="side-icon">{item.icon}</span>
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="side-foot">
        <a href="/" target="_blank" rel="noopener" class="side-link">🌐 查看前台</a>
        <button type="button" class="side-link logout" id="logout-btn">⏻ 退出登录</button>
      </div>
    </aside>

    <main class="admin-main">
      <header class="topbar">
        <h1>{title}</h1>
        {username && <span class="who">👤 {username}</span>}
      </header>
      <div class="content">
        <slot />
      </div>
    </main>

    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/logout', { method: 'POST' });
        location.href = '/admin/login';
      });
    </script>

    <style>
      .admin-body {
        display: flex;
        min-height: 100vh;
        background: var(--bg);
      }

      /* 侧边栏 */
      .sidebar {
        width: 220px;
        flex-shrink: 0;
        background: var(--bg-soft);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        padding: 20px 14px;
        position: sticky;
        top: 0;
        height: 100vh;
      }

      .side-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        color: var(--text);
        padding: 6px 10px 18px;
        font-size: 1.02rem;
      }

      .side-nav {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
      }

      .side-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        border-radius: 8px;
        color: var(--text-dim);
        font-size: 0.92rem;
        border: none;
        background: none;
        cursor: pointer;
        font-family: inherit;
        text-align: left;
        width: 100%;
        transition: all 0.15s ease;
      }

      .side-link:hover {
        background: var(--bg-soft);
        color: var(--text);
      }

      .side-link.active {
        background: var(--accent-soft);
        color: var(--accent);
        font-weight: 600;
      }

      .side-icon {
        width: 20px;
        text-align: center;
      }

      .side-foot {
        display: flex;
        flex-direction: column;
        gap: 4px;
        border-top: 1px solid var(--border);
        padding-top: 12px;
      }

      .logout:hover {
        color: var(--red) !important;
      }

      /* 主区域 */
      .admin-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 32px;
        background: var(--bg-soft);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .topbar h1 {
        margin: 0;
        font-size: 1.25rem;
      }

      .who {
        font-size: 0.88rem;
        color: var(--text-dim);
        font-family: var(--font-mono);
      }

      .content {
        padding: 28px 32px;
        max-width: 960px;
        width: 100%;
      }

      /* 通用后台组件 */
      :global(.panel) {
        background: var(--bg-soft);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 22px 24px;
        margin-bottom: 20px;
      }

      :global(.panel h2) {
        margin: 0 0 16px;
        font-size: 1.05rem;
      }

      :global(.stat-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 14px;
        margin-bottom: 20px;
      }

      :global(.stat-card) {
        background: var(--bg-soft);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 18px;
      }

      :global(.stat-num) {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--accent);
        font-family: var(--font-mono);
      }

      :global(.stat-label) {
        font-size: 0.85rem;
        color: var(--text-dim);
      }

      :global(.admin-table) {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }

      :global(.admin-table th) {
        text-align: left;
        padding: 8px 10px;
        border-bottom: 2px solid var(--border);
        color: var(--text-dim);
        font-size: 0.8rem;
        background: none;
      }

      :global(.admin-table td) {
        padding: 10px;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
      }

      :global(.admin-table tr:hover td) {
        background: var(--bg-soft);
      }

      :global(.badge) {
        font-size: 0.72rem;
        padding: 2px 9px;
        border-radius: 999px;
        font-family: var(--font-mono);
      }

      :global(.badge.published) {
        background: rgba(26, 127, 55, 0.12);
        color: var(--green);
      }

      :global(.badge.draft) {
        background: rgba(191, 135, 0, 0.14);
        color: var(--yellow);
      }

      :global(.mini-btn) {
        font-size: 0.8rem;
        padding: 4px 11px;
        border-radius: 6px;
        border: 1px solid var(--border-strong);
        background: var(--bg-soft);
        color: var(--text);
        cursor: pointer;
        transition: all 0.15s ease;
        text-decoration: none;
        display: inline-block;
        font-family: inherit;
      }

      :global(.mini-btn:hover) {
        border-color: var(--accent);
        color: var(--accent);
      }

      :global(.mini-btn.danger:hover) {
        border-color: var(--red);
        color: var(--red);
      }

      :global(.admin-field) {
        margin-bottom: 16px;
      }

      :global(.admin-field label) {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 6px;
        color: var(--text-dim);
      }

      :global(.admin-field input),
      :global(.admin-field textarea),
      :global(.admin-field select) {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 0.93rem;
        font-family: inherit;
        color: var(--text);
        background: var(--bg);
        outline: none;
        transition: all 0.15s ease;
      }

      :global(.admin-field input:focus),
      :global(.admin-field textarea:focus),
      :global(.admin-field select:focus) {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }

      :global(.admin-field textarea) {
        resize: vertical;
        font-family: var(--font-mono);
        line-height: 1.6;
      }

      :global(.form-row) {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      :global(.form-actions) {
        display: flex;
        gap: 10px;
        margin-top: 20px;
        align-items: center;
      }

      :global(.form-msg) {
        font-size: 0.85rem;
        margin-left: 8px;
      }

      :global(.form-msg.ok) {
        color: var(--green);
      }

      :global(.form-msg.err) {
        color: var(--red);
      }

      :global(.editor-preview) {
        margin-top: 12px;
        padding: 16px 18px;
        border: 1px dashed var(--border-strong);
        border-radius: var(--radius);
        background: var(--bg);
      }

      :global(.empty-tip) {
        color: var(--text-faint);
        padding: 22px 0;
        text-align: center;
        font-size: 0.9rem;
      }

      @media (max-width: 768px) {
        .sidebar {
          width: 64px;
          padding: 16px 8px;
        }
        .side-brand span:last-child,
        .side-link {
          font-size: 0;
          justify-content: center;
          padding: 10px;
        }
        .side-icon {
          font-size: 1.1rem;
        }
        .content {
          padding: 18px 16px;
        }
        .topbar {
          padding: 14px 16px;
        }
        :global(.form-row) {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
