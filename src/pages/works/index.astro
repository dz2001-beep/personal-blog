---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import PageWidgets from '../../components/PageWidgets.astro';
import Mascot from '../../components/Mascot.astro';
import { getAllWorks } from '../../lib/db';

const works = getAllWorks();
---

<BaseLayout
  title="作品"
  description="个人作品集"
  bgImage="/gallery/mountain-river.jpg"
  bgTint="rgba(118, 196, 186, 0.16)"
>
  <section class="container-wide">
    <header class="page-head fade-up">
      <span class="page-kicker">Projects</span>
      <h1>我的作品</h1>
      <p>业余时间折腾的一些项目,欢迎 Star 和提 issue。</p>
      <Mascot />
    </header>

    <PageWidgets hot={false} />

    {
      works.length > 0 ? (
        <div class="work-grid">
          {works.map((work) => <WorkCard work={work} />)}
        </div>
      ) : (
        <p class="empty">还没有作品,登录后台添加第一个作品吧!</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 48px 0 26px;
  }

  .page-head h1 {
    margin: 0 0 6px;
    font-size: 2.2rem;
  }

  .page-head p {
    margin: 0;
    color: var(--text-dim);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 18px;
    margin-bottom: 60px;
  }

  .empty {
    color: var(--text-dim);
    padding: 40px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: center;
  }
</style>
