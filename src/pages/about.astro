---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import { PROFILE } from '../data/profile';
import { getSiteConfig } from '../lib/db';
import { mdInline } from '../utils/md';

const site = getSiteConfig();
const bio = site.bio || PROFILE.bio;
const bioParagraphs = bio.split('\n\n').filter((p) => p.trim());

const socialContact = [
  { href: site.social.github, label: 'GitHub', show: !!site.social.github },
  { href: site.social.email ? `mailto:${site.social.email}` : '', label: 'Email', show: !!site.social.email },
  { href: site.social.twitter, label: 'Twitter', show: !!site.social.twitter },
  { href: site.social.juejin, label: '掘金', show: !!site.social.juejin },
].filter((s) => s.show);
---

<BaseLayout title="关于我" description={`${site.author} 的个人简介、技能与经历`}>
  <!-- 个人信息头部 -->
  <section class="profile-head">
    <div class="container profile-card fade-up">
      <Avatar size={120} alt={`${site.author} 的头像`} src={site.avatar} fallback={site.avatar} uploadable />
      <div class="profile-info">
        <h1>{site.author} <span class="handle">@{PROFILE.handle}</span></h1>
        <p class="profile-title">{PROFILE.title} · {PROFILE.tagline}</p>
        <div class="profile-contact">
          {
            socialContact.map((s) => (
              <a class="btn social-btn" href={s.href} target="_blank" rel="noopener">{s.label}</a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 个人简介(后台「设置」可在线修改) -->
  <section class="container">
    <h2 class="section-title">个人简介</h2>
    {
      bioParagraphs.length > 0 ? (
        bioParagraphs.map((para) => (
          <p class="bio-para" set:html={mdInline(para)}></p>
        ))
      ) : (
        <p class="bio-para" set:html={mdInline(PROFILE.bio)}></p>
      )
    }
  </section>

  <!-- 技术栈 -->
  <section class="container">
    <h2 class="section-title">技术栈</h2>
    <div class="skill-grid">
      {
        PROFILE.skills.map((group) => (
          <div class="skill-group">
            <h3 class="skill-group-name">{group.group}</h3>
            <div class="skill-items">
              {group.items.map((item) => <span class="skill-chip">{item}</span>)}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 工作经历 -->
  <section class="container">
    <h2 class="section-title">工作经历</h2>
    <div class="timeline">
      {
        PROFILE.experience.map((job) => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-body">
              <div class="timeline-head">
                <span class="timeline-period">{job.period}</span>
                <span class="timeline-company">{job.company}</span>
                <span class="timeline-role">{job.role}</span>
              </div>
              <p class="timeline-desc">{job.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 教育背景 -->
  <section class="container">
    <h2 class="section-title">教育背景</h2>
    <div class="timeline">
      {
        PROFILE.education.map((edu) => (
          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div class="timeline-body">
              <div class="timeline-head">
                <span class="timeline-period">{edu.period}</span>
                <span class="timeline-company">{edu.school}</span>
                <span class="timeline-role">{edu.major}</span>
              </div>
              {edu.desc && <p class="timeline-desc">{edu.desc}</p>}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .profile-head {
    padding: 56px 0 10px;
  }

  .profile-card {
    display: flex;
    align-items: center;
    gap: 32px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 34px 36px;
    box-shadow: var(--shadow-sm);
  }

  .profile-info h1 {
    margin: 0 0 6px;
  }

  .handle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-faint);
    font-weight: 400;
  }

  .profile-title {
    margin: 0 0 16px;
    color: var(--accent);
    font-weight: 600;
  }

  .profile-contact {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .social-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 5px 14px;
  }

  .bio-para {
    color: var(--text);
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }

  .skill-group {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px;
  }

  .skill-group-name {
    margin: 0 0 12px;
    font-size: 0.95rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .skill-group-name::before {
    content: '▸ ';
    color: var(--accent);
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-chip {
    font-size: 0.85rem;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--bg-softer);
    border: 1px solid var(--border);
    color: var(--text);
    transition: all 0.15s ease;
  }

  .skill-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* 时间线 */
  .timeline {
    border-left: 2px solid var(--border);
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .timeline-item {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -29px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .timeline-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .timeline-company {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .timeline-role {
    font-size: 0.85rem;
    color: var(--accent);
  }

  .timeline-desc {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  @media (max-width: 640px) {
    .profile-card {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      padding: 24px 18px;
      gap: 18px;
    }
    .profile-info h1 {
      font-size: 1.35rem;
    }
    .profile-contact {
      justify-content: flex-start;
    }
    .social-btn {
      padding: 4px 10px;
      font-size: 0.75rem;
    }
  }
</style>
