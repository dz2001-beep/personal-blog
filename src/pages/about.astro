---
/**
 * 关于我 —— 贴纸剪贴画风(scrapbook / sticker collage)
 *
 * 设计思路:
 *  - 深色站点里放"一张米白纸",像把一页剪贴簿钉在墙上
 *  - 照片做成拍立得(白框 + 手写说明 + 胶带),轻微旋转
 *  - 技术栈做成彩色贴纸(白描边 + 投影),经历做成手写清单
 *  - 装饰只用:胶带、图钉、手绘箭头、荧光笔高亮 —— 不用渐变光晕和玻璃卡
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import { PROFILE } from '../data/profile';
import { GALLERY } from '../data/gallery';
import { getSiteConfig } from '../lib/db';
import { mdInline } from '../utils/md';

const site = getSiteConfig();
const bio = site.bio || PROFILE.bio;
const bioParagraphs = bio.split('\n\n').filter((p) => p.trim());

const socialContact = [
  { href: site.social.github, label: 'GitHub', show: !!site.social.github },
  { href: site.social.email ? `mailto:${site.social.email}` : '', label: 'Email', show: !!site.social.email },
  { href: site.social.twitter, label: 'Twitter', show: !!site.social.twitter },
  { href: site.social.juejin, label: '掘金', show: !!site.social.juejin },
].filter((s) => s.show);

/** 剪贴簿上贴的相册照片:取 3 张不同的 */
const scrapPhotos = GALLERY.slice(0, 3);

/** 技术栈拍平成贴纸,分组作为标题 */
const skillGroups = PROFILE.skills;
---

<BaseLayout
  title="关于我"
  description={`${site.author} 的个人简介、技能与经历`}
  bgImage="/gallery/sunset-field.jpg"
  bgTint="rgba(226, 178, 132, 0.16)"
>
  <section class="scrap">
    <!-- ========== 米白纸 ========== -->
    <div class="sheet">
      <!-- 顶部胶带 -->
      <span class="tape tape-top" aria-hidden="true"></span>
      <span class="tape tape-top2" aria-hidden="true"></span>

      <div class="sheet-paper">
      <!-- ---------- 页首 ---------- -->
      <header class="sheet-head">
        <h1 class="sheet-title">
          <span class="marker">关于我</span>
        </h1>
        <p class="byline hand">
          <span class="pin" aria-hidden="true"></span>
          {site.author} · {PROFILE.title}
        </p>
        <svg class="doodle doodle-head" viewBox="0 0 120 60" aria-hidden="true">
          <path d="M4 12c22 26 52 34 96 26" />
          <path d="M100 38l12-8M100 38l-4 12" />
        </svg>
        <p class="hand-note hand">翻到这一页,是我自己写的东西 ↓</p>
      </header>

      <!-- ---------- 剪贴主区 ---------- -->
      <div class="collage">
        <!-- 头像拍立得 -->
        <figure class="polaroid polaroid-avatar rot-l">
          <span class="tape tape-photo" aria-hidden="true"></span>
          <div class="polaroid-frame">
            <Avatar size={168} alt={`${site.author} 的头像`} src={site.avatar} fallback={site.avatar} noTransition />
          </div>
          <figcaption class="hand">{site.author}</figcaption>
        </figure>

        <!-- 相册照片贴纸 -->
        {
          scrapPhotos.map((photo, i) => (
            <figure class:list={['polaroid', 'polaroid-photo', `p${i + 1}`]}>
              <div class="polaroid-frame">
                <img src={photo.src} alt={photo.title} loading="lazy" decoding="async" />
              </div>
              <figcaption class="hand">{photo.title}</figcaption>
            </figure>
          ))
        }

        <!-- 小纸条:一句话定位 -->
        <aside class="note note-tag">
          <span class="pin pin-sm" aria-hidden="true"></span>
          <p class="tag-line hand">{PROFILE.tagline}</p>
          <svg class="doodle doodle-tag" viewBox="0 0 80 40" aria-hidden="true">
            <path d="M4 30c18-18 44-22 72-8" />
            <path d="M68 14l10 8-9 7" />
          </svg>
        </aside>

        <!-- 便签:自我介绍 -->
        <article class="note note-bio">
          <h2 class="note-title">
            <span class="marker marker-soft">自我介绍</span>
          </h2>
          {
            bioParagraphs.length > 0 ? (
              bioParagraphs.map((para) => (
                <p class="note-text" set:html={mdInline(para)} />
              ))
            ) : (
              <p class="note-text" set:html={mdInline(PROFILE.bio)} />
            )
          }
          <p class="hand hand-tail">—— 说白了就是:喜欢把折腾出来的东西记下来。</p>

          {
            socialContact.length > 0 && (
              <div class="contact-row">
                {socialContact.map((s) => (
                  <a class="sticker sticker-link" href={s.href} target="_blank" rel="noopener">
                    {s.label}
                  </a>
                ))}
              </div>
            )
          }
        </article>

        <!-- 便签:技术栈贴纸 -->
        <article class="note note-skills">
          <h2 class="note-title">
            <span class="marker marker-soft">技术栈</span>
          </h2>
          {
            skillGroups.map((group) => (
              <div class="sticker-group">
                <span class="sticker-group-name hand">{group.group}</span>
                <div class="sticker-row">
                  {group.items.map((item, i) => (
                    <span class:list={['sticker', `c${(i % 4) + 1}`]}>{item}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </article>

        <!-- 便签:工作经历(手写清单) -->
        <article class="note note-exp">
          <h2 class="note-title">
            <span class="marker marker-soft">工作经历</span>
          </h2>
          <ul class="list-hand">
            {
              PROFILE.experience.map((job) => (
                <li>
                  <span class="list-period hand">{job.period}</span>
                  <span class="list-main">
                    <strong>{job.company}</strong>
                    <em>{job.role}</em>
                  </span>
                  <p class="list-desc">{job.desc}</p>
                </li>
              ))
            }
          </ul>
          <svg class="doodle doodle-star" viewBox="0 0 60 60" aria-hidden="true">
            <path d="M30 6l6 16 17 1-13 11 4 17-14-9-14 9 4-17-13-11 17-1z" />
          </svg>
        </article>

        <!-- 便签:教育 + 小纸条 -->
        <article class="note note-edu">
          <h2 class="note-title">
            <span class="marker marker-soft">教育背景</span>
          </h2>
          {
            PROFILE.education.map((edu) => (
              <div class="edu-item">
                <span class="list-period hand">{edu.period}</span>
                <strong>{edu.school}</strong>
                <span class="edu-major">{edu.major}</span>
                {edu.desc && <p class="list-desc">{edu.desc}</p>}
              </div>
            ))
          }
        </article>
      </div>

      <!-- ---------- 页脚 ---------------------------------------- -->
      <footer class="sheet-foot">
        <p class="hand">这一页会慢慢贴满 —— 想到什么就往上贴一张。</p>
        <span class="stamp" aria-hidden="true">DZ</span>
      </footer>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     纸张与墨色
     ============================================================ */
  .scrap {
    --paper: #f7f2e6;
    --paper-deep: #efe7d6;
    --ink: #2c2620;
    --ink-soft: #6b6155;
    --ink-faint: #9a8f7f;
    --tape: rgba(226, 205, 158, 0.85);
    --c1: #e2574c;
    --c2: #e8b64c;
    --c3: #4f8fc0;
    --c4: #6f9f6a;
    --hand: 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', 'Songti SC', var(--font-sans);

    padding: 46px 0 68px;
    /* 纸背后的一圈暖光,把纸和深色背景接起来 */
    background:
      radial-gradient(70% 46% at 50% 6%, rgba(226, 178, 132, 0.13), transparent 70%),
      radial-gradient(60% 40% at 50% 100%, rgba(226, 178, 132, 0.07), transparent 72%);
  }

  /* 纸:外层只负责"摆放"——轻微倾斜 + 跟随撕边的投影 */
  .sheet {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    color: var(--ink);
    transform: rotate(-0.35deg);
    /* drop-shadow 会沿着子元素 clip-path 的撕边形状投影 */
    filter:
      drop-shadow(0 2px 2px rgba(40, 30, 18, 0.28))
      drop-shadow(0 18px 34px rgba(0, 0, 0, 0.45))
      drop-shadow(0 0 26px rgba(226, 178, 132, 0.16));
  }

  /* 纸:带纤维纹理的米白,边缘用手撕多边形裁出来 */
  .sheet-paper {
    position: relative;
    padding: 50px 54px 42px;
    background-color: var(--paper);
    background-image:
      radial-gradient(circle at 18% 8%, rgba(255, 255, 255, 0.75), transparent 42%),
      radial-gradient(circle at 82% 92%, rgba(214, 200, 172, 0.35), transparent 46%),
      repeating-linear-gradient(92deg, rgba(120, 100, 70, 0.035) 0 1px, transparent 1px 5px),
      repeating-linear-gradient(2deg, rgba(120, 100, 70, 0.03) 0 1px, transparent 1px 7px);
    clip-path: polygon(0.00% 1.00%, 9.09% 0.01%, 18.18% -0.46%, 27.27% 0.34%, 36.36% -0.39%, 45.45% -0.27%, 54.55% 0.61%, 63.64% 0.65%, 72.73% 0.34%, 81.82% -0.26%, 90.91% -0.16%, 100.00% 0.90%, 99.92% 11.11%, 99.41% 22.22%, 100.39% 33.33%, 100.28% 44.44%, 99.87% 55.56%, 99.46% 66.67%, 100.17% 77.78%, 99.19% 88.89%, 99.40% 100.00%, 90.91% 99.91%, 81.82% 100.69%, 72.73% 100.00%, 63.64% 99.43%, 54.55% 100.50%, 45.45% 100.13%, 36.36% 100.80%, 27.27% 100.28%, 18.18% 99.86%, 9.09% 100.10%, 0.70% 99.20%, 0.11% 88.89%, -0.62% 77.78%, 0.22% 66.67%, 0.53% 55.56%, 0.65% 44.44%, 0.04% 33.33%, 0.38% 22.22%, -0.20% 11.11%);
  }

  /* 撕边内侧一层很淡的毛边阴影,强化"纸"的厚度 */
  .sheet-paper::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow:
      0 0 0 1px rgba(120, 100, 70, 0.1) inset,
      0 0 18px rgba(120, 100, 70, 0.12) inset;
  }

  /* ---------- 胶带 ---------- */
  .tape {
    position: absolute;
    display: block;
    width: 132px;
    height: 30px;
    background: linear-gradient(180deg, var(--tape), rgba(214, 190, 140, 0.75));
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.16);
    opacity: 0.92;
    pointer-events: none;
  }

  .tape::before,
  .tape::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    background: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0 3px, transparent 3px 6px);
  }

  .tape::before {
    left: -4px;
  }
  .tape::after {
    right: -4px;
  }

  .tape-top {
    top: -14px;
    left: 84px;
    transform: rotate(-4deg);
  }

  .tape-top2 {
    top: -12px;
    right: 96px;
    transform: rotate(3deg);
  }

  /* ---------- 页首 ---------- */
  .sheet-head {
    position: relative;
    padding-bottom: 26px;
  }

  .sheet-title {
    margin: 0 0 8px;
    font-size: 2.9rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  /* 荧光笔高亮 */
  .marker {
    background: linear-gradient(transparent 58%, rgba(232, 182, 76, 0.62) 58%, rgba(232, 182, 76, 0.62) 92%, transparent 92%);
    padding: 0 6px;
  }

  .marker-soft {
    background: linear-gradient(transparent 62%, rgba(232, 182, 76, 0.4) 62%, rgba(232, 182, 76, 0.4) 94%, transparent 94%);
  }

  .byline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  /* 图钉 */
  .pin {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #ff8f7e, var(--c1) 62%, #a33a32);
    box-shadow: 0 2px 3px rgba(0, 0, 0, 0.35);
    flex: 0 0 auto;
  }

  .hand {
    font-family: var(--hand);
  }

  .hand-note {
    position: absolute;
    right: 8px;
    top: 64px;
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
    transform: rotate(-3deg);
  }

  /* 手绘箭头 */
  .doodle {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  .doodle-head {
    position: absolute;
    left: -34px;
    top: 4px;
    width: 76px;
    transform: rotate(8deg);
  }

  /* ============================================================
     剪贴布局
     ============================================================ */
  .collage {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 18px 16px;
    align-items: start;
  }

  /* ---------- 拍立得 ---------- */
  .polaroid {
    position: relative;
    margin: 0;
    background: #fffdf8;
    padding: 12px 12px 6px;
    border-radius: 2px;
    box-shadow: 0 10px 22px rgba(60, 45, 25, 0.28), 0 2px 4px rgba(60, 45, 25, 0.18);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .polaroid:hover {
    transform: rotate(0deg) scale(1.02);
    box-shadow: 0 16px 32px rgba(60, 45, 25, 0.34), 0 3px 6px rgba(60, 45, 25, 0.2);
    z-index: 5;
  }

  .polaroid-frame {
    overflow: hidden;
    background: var(--paper-deep);
  }

  .polaroid-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .polaroid figcaption {
    padding: 7px 2px 4px;
    font-size: 0.86rem;
    color: var(--ink-soft);
    text-align: center;
  }

  .polaroid-avatar {
    grid-column: span 4;
    transform: rotate(-2.2deg);
  }

  .polaroid-avatar .polaroid-frame {
    aspect-ratio: 1 / 1;
  }

  .polaroid-avatar figcaption {
    font-size: 1rem;
  }

  .tape-photo {
    top: -13px;
    left: 50%;
    width: 96px;
    height: 24px;
    transform: translateX(-50%) rotate(-3deg);
  }

  .polaroid-photo {
    grid-column: span 2;
  }

  .polaroid-photo .polaroid-frame {
    aspect-ratio: 4 / 3;
  }

  .p1 {
    transform: rotate(3.4deg) translateY(10px);
  }
  .p2 {
    transform: rotate(-4.2deg) translateY(-6px);
  }
  .p3 {
    transform: rotate(2.2deg) translateY(14px);
  }

  /* ---------- 便签 ---------- */
  .note {
    position: relative;
    padding: 22px 24px;
    border-radius: 2px;
    background: #fffdf8;
    box-shadow: 0 8px 20px rgba(60, 45, 25, 0.16), 0 1px 3px rgba(60, 45, 25, 0.14);
  }

  /* 便签顶部的胶带 */
  .note::before {
    content: '';
    position: absolute;
    top: -11px;
    left: 26px;
    width: 76px;
    height: 22px;
    background: linear-gradient(180deg, var(--tape), rgba(214, 190, 140, 0.7));
    transform: rotate(-3deg);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);
    opacity: 0.9;
  }

  /* 小纸条:一句话定位 */
  .note-tag {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    padding: 18px 16px 14px;
    background: #fffaf0;
    transform: rotate(2.4deg);
  }

  .note-tag .pin-sm {
    width: 11px;
    height: 11px;
  }

  .tag-line {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    line-height: 1.7;
    color: var(--ink);
  }

  .doodle-tag {
    width: 100%;
    max-width: 70px;
    stroke: var(--c3);
    opacity: 0.8;
  }

  .note-title {
    margin: 0 0 12px;
    font-size: 1.12rem;
    color: var(--ink);
  }

  .note-text {
    margin: 0 0 10px;
    font-size: 0.94rem;
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .note-text :global(strong) {
    color: var(--ink);
  }

  .note-bio {
    grid-column: span 7;
    transform: rotate(0.6deg);
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0 30px,
      rgba(79, 143, 192, 0.14) 30px 31px
    );
    background-position: 0 22px;
  }

  .hand-tail {
    margin: 6px 0 0;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }

  /* ---------- 贴纸 ---------- */
  .sticker {
    display: inline-block;
    padding: 5px 14px;
    border-radius: 12px;
    font-size: 0.86rem;
    font-weight: 600;
    color: #fffdf8;
    /* 白描边 + 投影 = 贴纸感 */
    border: 3px solid #fffdf8;
    box-shadow: 0 2px 0 rgba(60, 45, 25, 0.18), 0 4px 10px rgba(60, 45, 25, 0.16);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.18);
  }

  .sticker:hover {
    transform: translateY(-2px) rotate(-1deg);
    box-shadow: 0 3px 0 rgba(60, 45, 25, 0.2), 0 8px 16px rgba(60, 45, 25, 0.22);
  }

  .c1 {
    background: var(--c1);
  }
  .c2 {
    background: var(--c2);
  }
  .c3 {
    background: var(--c3);
  }
  .c4 {
    background: var(--c4);
  }

  .sticker-link {
    background: var(--ink);
    text-decoration: none;
  }

  .note-skills {
    grid-column: span 5;
    transform: rotate(-0.8deg);
  }

  .sticker-group {
    margin-bottom: 12px;
  }

  .sticker-group:last-child {
    margin-bottom: 0;
  }

  .sticker-group-name {
    display: block;
    margin-bottom: 7px;
    font-size: 0.9rem;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
  }

  .sticker-row {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  /* ---------- 手写清单(经历) ---------- */
  .note-exp {
    grid-column: span 7;
    transform: rotate(0.9deg);
  }

  .list-hand {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .list-hand li {
    position: relative;
    padding-left: 18px;
    border-left: 2px dotted rgba(120, 100, 70, 0.35);
  }

  .list-hand li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c1);
    border: 2px solid #fffdf8;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  .list-period {
    display: block;
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin-bottom: 2px;
  }

  .list-main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }

  .list-main strong {
    font-size: 1rem;
    color: var(--ink);
  }

  .list-main em {
    font-style: normal;
    font-size: 0.84rem;
    color: var(--c3);
    font-weight: 600;
  }

  .list-desc {
    margin: 5px 0 0;
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  .doodle-star {
    position: absolute;
    right: 14px;
    bottom: 12px;
    width: 34px;
    stroke: var(--c2);
    opacity: 0.85;
  }

  /* ---------- 教育 ---------- */
  .note-edu {
    grid-column: span 5;
    order: 1;
    transform: rotate(-1.4deg);
  }

  .edu-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .edu-item strong {
    font-size: 1rem;
    color: var(--ink);
  }

  .edu-major {
    font-size: 0.86rem;
    color: var(--ink-soft);
  }

  /* ---------- 页脚 ---------- */
  .sheet-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 30px;
    padding-top: 16px;
    border-top: 1px dashed rgba(120, 100, 70, 0.3);
  }

  .sheet-foot p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-faint);
    transform: rotate(-0.6deg);
  }

  /* 印章 */
  .stamp {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid rgba(226, 87, 76, 0.6);
    color: rgba(226, 87, 76, 0.8);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transform: rotate(-12deg);
  }

  /* ============================================================
     响应式:窄屏去掉旋转、单列堆叠
     ============================================================ */
  @media (max-width: 900px) {
    .scrap {
      padding: 22px 12px 44px;
    }

    .sheet {
      transform: none;
    }

    .sheet-paper {
