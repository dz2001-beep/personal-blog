---
/**
 * 页面小人物:一只坐在页面头部横线上的小幽灵
 * - 纯 SVG,无图片依赖;眨眼、悬浮、指尖光点都是 CSS 动画
 * - 点它会说一句话(台词在 src/scripts/mascot.ts 里改)
 * - 放在 <header class="page-head"> 里,靠绝对定位贴右下角
 */
---

<div class="mascot" data-mascot role="button" tabindex="0" aria-label="点我说句话">
  <div class="mascot-bubble" data-mascot-bubble aria-hidden="true"></div>

  <svg class="mascot-body" viewBox="0 0 120 120" role="img" aria-hidden="true">
    <!-- 天线 -->
    <line class="mascot-antenna" x1="60" y1="26" x2="60" y2="12" />
    <circle class="mascot-dot" cx="60" cy="9" r="4.5" />

    <!-- 身体:上圆下摆(幽灵裙摆) -->
    <path
      class="mascot-shape"
      d="M60 18c-18.2 0-30 13.4-30 30.6v35.1c0 3.2 2.6 5 5.2 3.3l7.2-4.7c1.7-1.1 3.9-1 5.5.3l6.4 5.2c1.9 1.6 4.6 1.6 6.5 0l6.4-5.2c1.6-1.3 3.8-1.4 5.5-.3l7.2 4.7c2.6 1.7 5.2-.1 5.2-3.3V48.6C90 31.4 78.2 18 60 18z"
    />

    <!-- 腮红 -->
    <ellipse class="mascot-blush" cx="40" cy="64" rx="6.4" ry="4" />
    <ellipse class="mascot-blush" cx="80" cy="64" rx="6.4" ry="4" />

    <!-- 眼睛(眨眼靠 scaleY 动画) -->
    <ellipse class="mascot-eye" cx="48" cy="51" rx="4.6" ry="5.6" />
    <ellipse class="mascot-eye" cx="72" cy="51" rx="4.6" ry="5.6" />

    <!-- 嘴 -->
    <path class="mascot-mouth" d="M55 64q5 4.6 10 0" />

    <!-- 小手 -->
    <path class="mascot-hand mascot-hand-l" d="M32 74q-7 2-9 8" />
    <path class="mascot-hand mascot-hand-r" d="M88 74q7 2 9 8" />

    <!-- 地面投影:让它看起来是"坐"在线上的 -->
    <ellipse class="mascot-shadow" cx="60" cy="106" rx="20" ry="4.2" />
  </svg>
</div>

<script>
  import '../scripts/mascot';
</script>

<style>
  .mascot {
    position: absolute;
    right: 6px;
    bottom: 10px;
    width: 84px;
    height: 84px;
    cursor: pointer;
    transform-origin: 50% 100%;
    animation: mascotBob 4.2s ease-in-out infinite;
    z-index: 2;
  }

  .mascot-body {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.45));
  }

  .mascot-shape {
    fill: rgba(214, 224, 238, 0.14);
    stroke: rgba(214, 224, 238, 0.6);
    stroke-width: 2;
    transition: fill 0.3s ease, stroke 0.3s ease;
  }

  .mascot:hover .mascot-shape {
    fill: rgba(226, 235, 248, 0.22);
    stroke: rgba(236, 243, 252, 0.85);
  }

  .mascot-antenna {
    stroke: rgba(214, 224, 238, 0.55);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .mascot-dot {
    fill: #e8eef7;
    animation: mascotDot 2.4s ease-in-out infinite;
  }

  .mascot-eye {
    fill: #e8eef7;
    transform-box: fill-box;
    transform-origin: center;
    animation: mascotBlink 5.5s ease-in-out infinite;
  }

  .mascot-eye + .mascot-eye {
    animation-delay: 0.06s;
  }

  .mascot-blush {
    fill: rgba(198, 160, 176, 0.42);
  }

  .mascot-mouth {
    fill: none;
    stroke: rgba(232, 238, 247, 0.85);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .mascot-hand {
    fill: none;
    stroke: rgba(214, 224, 238, 0.5);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .mascot-shadow {
    fill: rgba(0, 0, 0, 0.42);
    animation: mascotShadow 4.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes mascotShadow {
    0%,
    100% {
      opacity: 0.55;
      transform: scaleX(1);
    }
    50% {
      opacity: 0.3;
      transform: scaleX(0.82);
    }
  }

  .mascot-hand-r {
    animation: mascotWave 3.6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: 0% 0%;
  }

  /* 说话气泡 */
  .mascot-bubble {
    position: absolute;
    right: 74px;
    bottom: 46px;
    width: max-content;
    max-width: 210px;
    padding: 8px 12px;
    border-radius: 12px 12px 3px 12px;
    border: 1px solid var(--border-strong);
    background: rgba(26, 32, 42, 0.95);
    color: var(--text);
    font-size: 0.78rem;
    line-height: 1.55;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(6px) scale(0.96);
    transform-origin: 100% 100%;
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
    white-space: normal;
  }

  .mascot-bubble.show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @keyframes mascotBob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes mascotBlink {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }
    95% {
      transform: scaleY(0.12);
    }
  }

  @keyframes mascotDot {
    0%,
    100% {
      opacity: 0.55;
      r: 4.5;
    }
    50% {
      opacity: 1;
      r: 5.4;
    }
  }

  @keyframes mascotWave {
    0%,
    70%,
    100% {
      transform: rotate(0deg);
    }
    80% {
      transform: rotate(-18deg);
    }
    90% {
      transform: rotate(10deg);
    }
  }

  /* 窄屏隐藏,避免挡住内容 */
  @media (max-width: 720px) {
    .mascot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot,
    .mascot-dot,
    .mascot-eye,
    .mascot-hand-r,
    .mascot-shadow {
      animation: none;
    }
  }
</style>
