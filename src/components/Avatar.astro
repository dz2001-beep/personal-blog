---
interface Props {
  size?: number;
  alt?: string;
  /** 是否支持本地上传(显示上传按钮) */
  uploadable?: boolean;
  /** 头像地址(来自站点设置,默认 /avatar.svg) */
  src?: string;
  /** 无本地头像时的回退地址 */
  fallback?: string;
  /** 禁用页面切换 morph 动画(同页出现多个头像时使用) */
  noTransition?: boolean;
}

const {
  size = 120,
  alt = '头像',
  uploadable = false,
  src = '/avatar.svg',
  fallback = src,
  noTransition = false,
} = Astro.props;
---

<div class="avatar-wrap">
  <img
    class="avatar avatar-img"
    src={src}
    data-fallback={fallback}
    alt={alt}
    width={size}
    height={size}
    transition:name={noTransition ? undefined : 'avatar'}
  />
  {
    uploadable && (
      <>
        <button type="button" class="avatar-upload-btn" data-avatar-upload title="上传头像">
          📷 更换头像
        </button>
        <button type="button" class="avatar-reset-btn" data-avatar-reset title="恢复默认头像">↺</button>
        <input type="file" accept="image/*" data-avatar-input hidden />
      </>
    )
  }
</div>

<style>
  .avatar {
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--bg-soft);
    flex-shrink: 0;
    object-fit: cover;
  }

  .avatar-reset-btn {
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
    transition: all 0.18s ease;
  }

  .avatar-reset-btn:hover {
    color: var(--red);
    border-color: var(--red);
    transform: rotate(-30deg);
  }
</style>
