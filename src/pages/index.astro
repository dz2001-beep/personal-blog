---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import PostCard from '../components/PostCard.astro';
import WorkCard from '../components/WorkCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getPublishedPosts, getFeaturedWorks, getSiteConfig } from '../lib/db';

const site = getSiteConfig();
const posts = getPublishedPosts().slice(0, 3);
const works = getFeaturedWorks().slice(0, 3);

const socialButtons = [
  { href: site.social.github, label: 'GitHub', show: !!site.social.github },
  { href: site.social.juejin, label: '掘金', show: !!site.social.juejin },
  { href: site.social.twitter, label: 'Twitter', show: !!site.social.twitter },
  { href: site.social.email ? `mailto:${site.social.email}` : '', label: 'Email', show: !!site.social.email },
].filter((s) => s.show);
---

<BaseLayout>
  <!-- ============ Hero(头像靠左,信息在右) ============ -->
  <section class="hero">
    <div class="container hero-inner fade-up">
      <Avatar size={132} alt={`${site.author} 的头像`} src={site.avatar} fallback={site.avatar} />
      <div class="hero-text">
        <h1 class="hero-title" id="hero-title">
          <span id="typed" data-text={site.heroTitle}></span><span class="typed-cursor">|</span>
        </h1>
        <p class="hero-tagline">
          <span class="hero-code">{'<'}dev{'>'}</span> {site.heroTagline}{' '}
          <span class="hero-code">{'</'}dev{'>'}</span>
        </p>
        <p class="hero-desc">{site.description}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/blog">📝 阅读文章</a>
          <a class="btn" href="/works">🚀 查看作品</a>
        </div>
        {
          socialButtons.length > 0 && (
            <div class="hero-social">
              {
                socialButtons.map((s) => (
                  <a class="btn social-btn" href={s.href} target="_blank" rel="noopener">{s.label}</a>
                ))
              }
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ============ 最近文章 + 精选作品(双栏:主内容 + 侧栏) ============ -->
  <div class="layout-two">
    <div class="layout-main">
      <section class="section container">
        <h2 class="section-title">最近文章</h2>
        {
          posts.length > 0 ? (
            <div class="post-list">
              {posts.map((post) => <PostCard post={post} />)}
            </div>
          ) : (
            <p class="empty">还没有文章,登录后台写第一篇吧!</p>
          )
        }
        <div class="section-more">
          <a class="btn" href="/blog">全部文章 →</a>
        </div>
      </section>

      <section class="section container">
        <h2 class="section-title">精选作品</h2>
        {
          works.length > 0 ? (
            <div class="work-grid">
              {works.map((work) => <WorkCard work={work} />)}
            </div>
          ) : (
            <p class="empty">还没有作品,登录后台添加第一个作品吧!</p>
          )
        }
        <div class="section-more">
          <a class="btn" href="/works">全部作品 →</a>
        </div>
      </section>
    </div>

    <Sidebar />
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 70px 0 50px;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    gap: 42px;
  }

  .hero-title {
    font-size: 2.4rem;
    margin: 0 0 8px;
    min-height: 1.3em;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-tagline {
    margin: 0 0 10px;
    font-size: 1.05rem;
    color: var(--text);
    font-weight: 600;
  }

  .hero-code {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .hero-desc {
    margin: 0 0 22px;
    color: var(--text-dim);
    max-width: 560px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-social {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .social-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 5px 12px;
    color: var(--text-dim);
  }

  .social-btn:hover {
    color: var(--accent);
  }

  .section {
    margin-top: 44px;
  }

  .layout-main .section:first-child {
    margin-top: 0;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
  }

  .section-more {
    margin-top: 20px;
    text-align: center;
  }

  .empty {
    color: var(--text-dim);
    padding: 24px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: center;
  }

  /* 手机端:头像依然靠左,内容在右侧 */
  @media (max-width: 640px) {
    .hero {
      padding: 44px 0 30px;
    }
    .hero-inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 20px;
    }
    .hero-title {
      font-size: 1.55rem;
    }
    .hero-desc {
      font-size: 0.9rem;
    }
    .hero-actions {
      gap: 8px;
    }
  }

  @media (max-width: 400px) {
    .hero-inner {
      gap: 14px;
    }
    .hero-actions .btn {
      padding: 8px 12px;
      font-size: 0.85rem;
    }
  }
</style>
