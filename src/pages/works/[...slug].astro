---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWorkBySlug } from '../../lib/db';
import { renderMarkdown } from '../../lib/md';
import { formatDate } from '../../utils/format';

const slug = Astro.params.slug;
const work = getWorkBySlug(slug || '');
if (!work) {
  return Astro.redirect('/404');
}

const { html } = await renderMarkdown(work.content);
const { title, description, tech, demo_url, repo_url } = work;
---

<BaseLayout
  title={title}
  description={description}
  bgImage="/gallery/snow-mountain.jpg"
  bgTint="rgba(148, 178, 214, 0.16)"
>
  <article class="container prose work-page">
    <header class="work-head fade-up">
      <h1>{title}</h1>
      <p class="work-desc">{description}</p>
      <div class="work-meta">
        <time datetime={work.created_at}>{formatDate(new Date(work.created_at))}</time>
      </div>
      {
        tech.length > 0 && (
          <div class="work-tech">
            {tech.map((t) => <span class="tag">{t}</span>)}
          </div>
        )
      }
      <div class="work-actions">
        {demo_url && <a class="btn btn-primary" href={demo_url} target="_blank" rel="noopener">在线演示</a>}
        {repo_url && <a class="btn" href={repo_url} target="_blank" rel="noopener">查看源码</a>}
        <a class="btn" href="/works">← 返回作品列表</a>
      </div>
    </header>

    <div class="work-body">
      <div set:html={html} />
    </div>
  </article>
</BaseLayout>

<style>
  .work-page {
    padding-top: 44px;
    padding-bottom: 60px;
  }

  .work-head {
    margin-bottom: 30px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border);
  }

  .work-head h1 {
    margin: 0 0 10px;
    font-size: 2.1rem;
  }

  .work-desc {
    margin: 0 0 12px;
    color: var(--text-dim);
    font-size: 1.02rem;
  }

  .work-meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-faint);
    margin-bottom: 14px;
  }

  .work-tech {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .work-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .work-head h1 {
      font-size: 1.7rem;
    }
  }
</style>
