---
import '../../styles/global.css';
import { getSiteConfig } from '../../lib/db';

const site = getSiteConfig();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登录 · 后台 | {site.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="login-body">
    <div class="login-card">
      <div class="login-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="10" width="16" height="10" rx="2.2" />
          <path d="M8 10V7.5a4 4 0 0 1 8 0V10" />
          <circle cx="12" cy="15" r="1.2" fill="currentColor" stroke="none" />
        </svg>
      </div>
      <h1>管理后台</h1>
      <p class="login-sub">登录后即可在线写作与管理站点</p>

      <form id="login-form">
        <div class="field">
          <label>用户名</label>
          <input id="username" type="text" autocomplete="username" placeholder="admin" required />
        </div>
        <div class="field">
          <label>密码</label>
          <input id="password" type="password" autocomplete="current-password" placeholder="••••••••" required />
        </div>
        <p class="msg" id="msg"></p>
        <button type="submit" class="btn btn-primary login-btn">登 录</button>
      </form>

      <p class="login-foot">
        <a href="/">← 返回首页</a>
      </p>
    </div>

    <script>
      // 与前台/后台一致的自定义光标(脚本自己建 #cursor-glow + has-custom-cursor)
      import '../../scripts/cursor';

      const form = document.getElementById('login-form') as HTMLFormElement;
      const msg = document.getElementById('msg')!;
      const btn = form.querySelector('button')!;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        msg.textContent = '';
        btn.disabled = true;
        btn.textContent = '登录中…';
        try {
          const res = await fetch('/api/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              username: (document.getElementById('username') as HTMLInputElement).value,
              password: (document.getElementById('password') as HTMLInputElement).value,
            }),
          });
          const result = await res.json();
          if (res.ok) {
            location.href = '/admin';
            return;
          }
          msg.textContent = result.error || '登录失败';
        } catch {
          msg.textContent = '网络错误';
        }
        btn.disabled = false;
        btn.textContent = '登 录';
      });
    </script>

    <style>
      /*
       * 后台登录页:与后台一致的浅色文档风。
       * 它不走 AdminLayout,所以这里单独覆盖一遍 CSS 变量。
       */
      .login-body {
        --bg: #fbfaf7;
        --bg-soft: #ffffff;
        --bg-softer: #f1f0ea;
        --border: #e7e5e0;
        --border-strong: #d4d1c9;
        --text: #1a1a18;
        --text-dim: #5f5e57;
        --text-faint: #96958d;
        --accent: #b45309;
        --accent-soft: rgba(180, 83, 9, 0.1);
        --red: #c02a20;
        --radius: 12px;
        --shadow: 0 20px 48px rgba(28, 25, 23, 0.1);
        --shadow-sm: 0 1px 2px rgba(28, 25, 23, 0.05);

        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        color: var(--text);
        background-color: var(--bg);
        /* 细点阵纸面底纹,替代原来的彩色光晕 */
        background-image: radial-gradient(rgba(28, 25, 23, 0.055) 1px, transparent 1px);
        background-size: 18px 18px;
        -webkit-font-smoothing: antialiased;
      }

      .login-card {
        width: 100%;
        max-width: 372px;
        background: var(--bg-soft);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 36px 32px 28px;
        box-shadow: var(--shadow);
        text-align: center;
        animation: fadeUp 0.45s ease both;
      }

      .login-logo {
        width: 46px;
        height: 46px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--bg-softer);
        border: 1px solid var(--border);
        color: var(--accent);
      }

      .login-logo svg {
        width: 22px;
        height: 22px;
      }

      .login-card h1 {
        margin: 0 0 4px;
        font-size: 1.24rem;
        font-weight: 650;
        letter-spacing: -0.015em;
        font-family: var(--font-sans);
      }

      .login-sub {
        margin: 0 0 24px;
        color: var(--text-faint);
        font-size: 0.84rem;
      }

      .field {
        text-align: left;
        margin-bottom: 13px;
      }

      .field label {
        display: block;
        font-size: 0.79rem;
        font-weight: 600;
        color: var(--text-dim);
        margin-bottom: 6px;
      }

      .field input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fff;
        color: var(--text);
        font-size: 0.93rem;
        outline: none;
        transition: border-color 0.14s ease, box-shadow 0.14s ease;
        box-sizing: border-box;
      }

      .field input::placeholder {
        color: var(--text-faint);
      }

      .field input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }

      .msg {
        min-height: 1.4em;
        margin: 0 0 6px;
        font-size: 0.82rem;
        color: var(--red);
        text-align: left;
      }

      .login-btn {
        width: 100%;
        justify-content: center;
        padding: 11px;
        font-size: 0.93rem;
        border-radius: 8px;
      }

      .login-foot {
        margin: 20px 0 0;
        font-size: 0.82rem;
      }

      .login-foot a {
        color: var(--text-faint);
      }

      .login-foot a:hover {
        color: var(--accent);
      }

      /* 白底上原本的白色光晕不可见,换成深墨色(悬停琥珀金) */
      :global(.login-body #cursor-glow) {
        background: radial-gradient(
          circle,
          rgba(26, 26, 24, 0.16),
          rgba(26, 26, 24, 0.05) 60%,
          transparent 72%
        );
      }

      :global(.login-body #cursor-glow.cursor-hover) {
        background: radial-gradient(
          circle,
          rgba(180, 83, 9, 0.22),
          rgba(180, 83, 9, 0.07) 60%,
          transparent 72%
        );
      }
    </style>
  </body>
</html>
