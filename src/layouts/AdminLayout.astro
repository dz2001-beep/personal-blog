---
import '../styles/global.css';
import { getSiteConfig } from '../lib/db';

interface Props {
  title: string;
}

const { title } = Astro.props;
const site = getSiteConfig();
const { pathname } = Astro.url;
const username = Astro.locals.username ?? '';

const navItems = [
  { href: '/admin', label: '仪表盘', icon: 'grid' },
  { href: '/admin/posts/new', label: '写文章', icon: 'pen' },
  { href: '/admin/works/new', label: '新作品', icon: 'box' },
  { href: '/admin/settings', label: '设置', icon: 'sliders' },
];

function isActive(href: string): boolean {
  if (href === '/admin') return pathname === '/admin';
  return pathname.startsWith(href);
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · 后台 | {site.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="admin-body">
    <aside class="sidebar">
      <a href="/" class="side-brand">
        <span class="brand-mark">&lt;/&gt;</span>
        <span class="brand-text">管理后台</span>
      </a>

      <nav class="side-nav">
        {
          navItems.map((item) => (
            <a href={item.href} class:list={['side-link', { active: isActive(item.href) }]}>
              <span class="side-icon" aria-hidden="true">
                {item.icon === 'grid' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                  </svg>
                )}
                {item.icon === 'pen' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12.5 20H21" />
                    <path d="M16.6 3.6a2 2 0 0 1 2.9 2.9L7.5 18.5 3 20l1.5-4.5z" />
                  </svg>
                )}
                {item.icon === 'box' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" />
                    <path d="M4 7.5l8 4.5 8-4.5" />
                    <path d="M12 12v9" />
                  </svg>
                )}
                {item.icon === 'sliders' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 7h9" />
                    <path d="M17 7h3" />
                    <circle cx="15" cy="7" r="2" />
                    <path d="M4 17h4" />
                    <path d="M12 17h8" />
                    <circle cx="10" cy="17" r="2" />
                  </svg>
                )}
              </span>
              <span class="side-text">{item.label}</span>
            </a>
          ))
        }
      </nav>

      <div class="side-foot">
        <a href="/" target="_blank" rel="noopener" class="side-link">
          <span class="side-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18" />
              <path d="M12 3c2.4 2.5 3.7 5.6 3.7 9s-1.3 6.5-3.7 9c-2.4-2.5-3.7-5.6-3.7-9S9.6 5.5 12 3z" />
            </svg>
          </span>
          <span class="side-text">查看前台</span>
        </a>
        <button type="button" class="side-link logout" id="logout-btn">
          <span class="side-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3.5v8.5" />
              <path d="M6.4 7.2a8 8 0 1 0 11.2 0" />
            </svg>
          </span>
          <span class="side-text">退出登录</span>
        </button>
      </div>
    </aside>

    <main class="admin-main">
      <header class="topbar">
        <h1>{title}</h1>
        {username && <span class="who">{username}</span>}
      </header>
      <div class="content">
        <slot />
      </div>
    </main>

    <script>
      // 自定义光标(彩色箭头 + 跟手光晕):脚本会自己创建 #cursor-glow 并给 <html> 加
      // has-custom-cursor,所以后台只要引入即可,样式复用 global.css 里那套
      import '../scripts/cursor';

      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/logout', { method: 'POST' });
        location.href = '/admin/login';
      });
    </script>

    <style>
      /*
       * 后台主题:浅色文档风(纸白底 + 细边框 + 无玻璃质感),
       * 与深色前台形成"工作区 / 展示区"的对比。
       * 做法是就地覆盖全局 CSS 变量 —— 后台页面和编辑器都只用 var(--*),
       * 所以一处改 token 就能整体换肤,不必逐个组件改颜色。
       */
      .admin-body {
        /* 配色 */
        --bg: #ffffff;
        --bg-soft: #faf9f7;
        --bg-softer: #f0efea;
        --border: #e7e5e0;
        --border-strong: #d4d1c9;

        --text: #1a1a18;
        --text-dim: #5f5e57;
        --text-faint: #96958d;

        /* 琥珀金在白底上要压深,否则对比度不足 */
        --accent: #b45309;
        --accent-2: #92400e;
        --accent-soft: rgba(180, 83, 9, 0.1);
        --green: #2f855a;
        --red: #c02a20;
        --yellow: #a16207;

        /* 质感:扁平化,阴影收得很轻 */
        --radius: 10px;
        --radius-sm: 7px;
        --shadow: 0 18px 44px rgba(28, 25, 23, 0.1);
        --shadow-sm: 0 1px 2px rgba(28, 25, 23, 0.05);
        /* 全局卡片用 background: var(--glass-gradient), var(--glass-solid);
           这里换成一枚全透明渐变,等于去掉玻璃质感 */
        --glass-gradient: linear-gradient(rgba(255, 255, 255, 0), rgba(255, 255, 255, 0));
        --glass-solid: #ffffff;

        display: flex;
        min-height: 100vh;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      /*
       * 自定义光晕在深色前台是白色半透明;后台是白底,照搬会完全看不见。
       * 这里换成深墨色(悬停变琥珀金),既保留跟手光晕的手感,又不刺眼。
       * 箭头本身沿用 public/cursor.png / cursor.svg,与前台完全一致。
       */
      :global(.admin-body #cursor-glow) {
        background: radial-gradient(
          circle,
          rgba(26, 26, 24, 0.16),
          rgba(26, 26, 24, 0.05) 60%,
          transparent 72%
        );
      }

      :global(.admin-body #cursor-glow.cursor-hover) {
        background: radial-gradient(
          circle,
          rgba(180, 83, 9, 0.22),
          rgba(180, 83, 9, 0.07) 60%,
          transparent 72%
        );
      }

      /* 后台标题不用前台的宋体,回到干净的无衬线 */
      .admin-body h1,
      .admin-body h2,
      .admin-body h3 {
        font-family: var(--font-sans);
        letter-spacing: -0.011em;
      }

      /* ---------- 侧边栏 ---------- */
      .sidebar {
        width: 212px;
        flex-shrink: 0;
        background: var(--bg-soft);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        padding: 18px 12px;
        position: sticky;
        top: 0;
        height: 100vh;
      }

      .side-brand {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--text);
        padding: 4px 8px 18px;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .brand-mark {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 7px;
        border: 1px solid var(--border-strong);
        background: #fff;
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
      }

      .side-nav {
        display: flex;
        flex-direction: column;
        gap: 2px;
        flex: 1;
      }

      .side-link {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: var(--radius-sm);
        color: var(--text-dim);
        font-size: 0.875rem;
        border: none;
        background: none;
        cursor: pointer;
        font-family: inherit;
        text-align: left;
        width: 100%;
        transition: background-color 0.14s ease, color 0.14s ease;
      }

      .side-link:hover {
        background: var(--bg-softer);
        color: var(--text);
      }

      .side-link.active {
        background: #fff;
        color: var(--text);
        font-weight: 600;
        box-shadow: inset 0 0 0 1px var(--border);
      }

      /* 选中态左侧一道琥珀金细条,代替原来的整块高亮 */
      .side-link.active::before {
        content: '';
        position: absolute;
        left: -12px;
        top: 50%;
        transform: translateY(-50%);
        width: 2px;
        height: 16px;
        border-radius: 2px;
        background: var(--accent);
      }

      .side-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 17px;
        height: 17px;
        flex-shrink: 0;
        color: currentColor;
      }

      .side-icon svg {
        width: 100%;
        height: 100%;
      }

      .side-link.active .side-icon {
        color: var(--accent);
      }

      .side-foot {
        display: flex;
        flex-direction: column;
        gap: 2px;
        border-top: 1px solid var(--border);
        padding-top: 10px;
        margin-top: 10px;
      }

      .logout:hover {
        color: var(--red) !important;
      }

      /* ---------- 主区域 ---------- */
      .admin-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        background: var(--bg);
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 36px;
        background: rgba(255, 255, 255, 0.86);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .topbar h1 {
        margin: 0;
        font-size: 1.14rem;
        font-weight: 650;
      }

      .who {
        font-size: 0.78rem;
        color: var(--text-faint);
        font-family: var(--font-mono);
        padding: 3px 9px;
        border: 1px solid var(--border);
        border-radius: 999px;
      }

      .content {
        padding: 30px 36px 60px;
        max-width: 1120px;
        width: 100%;
        box-sizing: border-box;
      }

      /* ---------- 面板:白卡 + 细边 + 极轻阴影 ---------- */
      :global(.admin-body .panel) {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 22px 24px;
        margin-bottom: 18px;
        box-shadow: var(--shadow-sm);
        backdrop-filter: none;
      }

      /* 后台不要前台那套角标 / 顶部发丝线 */
      :global(.admin-body .panel::after),
      :global(.admin-body .panel::before) {
        display: none;
      }

      :global(.panel h2) {
        margin: 0 0 16px;
        font-size: 1rem;
        font-weight: 650;
      }

      /* ---------- 统计卡 ---------- */
      :global(.stat-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        margin-bottom: 18px;
      }

      :global(.stat-card) {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 18px;
        box-shadow: var(--shadow-sm);
      }

      :global(.stat-num) {
        font-size: 1.65rem;
        font-weight: 700;
        color: var(--text);
        font-family: var(--font-mono);
        letter-spacing: -0.02em;
        line-height: 1.2;
      }

      :global(.stat-label) {
        font-size: 0.78rem;
        color: var(--text-faint);
        margin-top: 2px;
      }

      /* ---------- 表格 ---------- */
      :global(.admin-table) {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
      }

      :global(.admin-table th) {
        text-align: left;
        padding: 8px 10px;
        border-bottom: 1px solid var(--border);
        color: var(--text-faint);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        background: none;
        white-space: nowrap;
      }

      :global(.admin-table td) {
        padding: 11px 12px;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
        /* 除第一列(标题,允许折行)外都不换行,否则徽章和日期会被挤断 */
        white-space: nowrap;
      }

      :global(.admin-table td:first-child) {
        white-space: normal;
        min-width: 240px;
      }

      :global(.admin-table tr:hover td) {
        background: var(--bg-soft);
      }

      :global(.badge) {
        display: inline-block;
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 999px;
        font-family: var(--font-mono);
        white-space: nowrap;
      }

      :global(.badge.published) {
        background: rgba(47, 133, 90, 0.1);
        color: var(--green);
      }

      :global(.badge.draft) {
        background: rgba(161, 98, 7, 0.1);
        color: var(--yellow);
      }

      :global(.mini-btn) {
        font-size: 0.78rem;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid var(--border-strong);
        background: #fff;
        color: var(--text-dim);
        cursor: pointer;
        transition: all 0.14s ease;
        text-decoration: none;
        display: inline-block;
        font-family: inherit;
      }

      :global(.mini-btn:hover) {
        border-color: var(--text-faint);
        color: var(--text);
      }

      :global(.mini-btn.danger:hover) {
        border-color: var(--red);
        color: var(--red);
      }

      /* ---------- 表单 ---------- */
      :global(.admin-field) {
        margin-bottom: 16px;
      }

      :global(.admin-field label) {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 6px;
        color: var(--text-dim);
      }

      :global(.admin-field input),
      :global(.admin-field textarea),
      :global(.admin-field select) {
        width: 100%;
        padding: 9px 11px;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 0.92rem;
        font-family: inherit;
        color: var(--text);
        background: #fff;
        outline: none;
        transition: border-color 0.14s ease, box-shadow 0.14s ease;
        box-sizing: border-box;
      }

      :global(.admin-field input::placeholder),
      :global(.admin-field textarea::placeholder) {
        color: var(--text-faint);
      }

      :global(.admin-field input:focus),
      :global(.admin-field textarea:focus),
      :global(.admin-field select:focus) {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }

      :global(.admin-field textarea) {
        resize: vertical;
        font-family: var(--font-mono);
        line-height: 1.65;
        font-size: 0.88rem;
      }

      :global(.form-row) {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      :global(.form-actions) {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
        align-items: center;
      }

      /* 后台按钮:不压缩、文字不换行(移动端否则会被挤成竖排) */
      :global(.admin-body .form-actions .btn) {
        flex: 0 0 auto;
        white-space: nowrap;
      }

      :global(.form-msg) {
        font-size: 0.82rem;
        margin-left: 8px;
      }

      :global(.form-msg.ok) {
        color: var(--green);
      }

      :global(.form-msg.err) {
        color: var(--red);
      }

      /* Markdown 预览区:纸面感 */
      :global(.editor-preview) {
        margin-top: 12px;
        padding: 18px 20px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--bg-soft);
      }

      :global(.empty-tip) {
        color: var(--text-faint);
        padding: 22px 0;
        text-align: center;
        font-size: 0.88rem;
      }

      @media (max-width: 768px) {
        .sidebar {
          width: 60px;
          padding: 14px 8px;
        }
        .brand-text,
        .side-text {
          display: none;
        }
        .side-brand,
        .side-link {
          justify-content: center;
          padding: 9px;
        }
        .side-link.active::before {
          left: -8px;
        }
        .content {
          padding: 18px 16px 48px;
        }
        .topbar {
          padding: 13px 16px;
        }
        :global(.form-row) {
          grid-template-columns: 1fr;
        }
        /* 统计卡改成两列,别一个占一整行 */
        :global(.stat-grid) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        /* 表格在面板内部横向滚动,不撑破页面 */
        :global(.admin-body .panel) {
          overflow-x: auto;
        }
        :global(.admin-table) {
          min-width: 620px;
        }
      }
    </style>
  </body>
</html>
