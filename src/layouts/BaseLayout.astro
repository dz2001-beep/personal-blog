---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../lib/db';

interface Props {
  title?: string;
  description?: string;
  /**
   * 页面背景图(内页使用;首页有自己的一套封面/背景,不传)
   * 传 public 下的路径,例如 '/gallery/forest.jpg'
   */
  bgImage?: string;
  /** 背景色调(强调色),用于页面上方的光晕,让各页有各自的氛围 */
  bgTint?: string;
}

const site = getSiteConfig();

const {
  title = site.title,
  description = site.description,
  bgImage,
  bgTint = 'rgba(120, 156, 210, 0.16)',
} = Astro.props;

const pageTitle = title === site.title ? site.title : `${title} | ${site.title}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />

    <!-- Open Graph / 社交分享卡片 -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.title} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <!-- 页面切换过渡动画 -->
    <ClientRouter />
  </head>
  <body>
    <!-- 内页背景层(首页自带封面,不渲染这一层) -->
    {
      bgImage && (
        <div class="page-bg" aria-hidden="true" style={`--page-tint:${bgTint}`}>
          <div class="page-bg-img" style={`background-image:url('${bgImage}')`} />
          <div class="page-bg-veil" />
          <div class="page-bg-glow" />
        </div>
      )
    }

    <!-- 阅读进度条 -->
    <div id="progress-bar" aria-hidden="true"></div>

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- 回到顶部 -->
    <button id="back-to-top" aria-label="回到顶部" title="回到顶部">↑</button>

    <!-- 前台交互:头像同步/打字机/滚动渐显 + 背景樱花动画 + 自定义光标 + 小宠物 + 彩蛋 -->
    <script>
      import '../scripts/site';
      import '../scripts/background';
      import '../scripts/cursor';
      import '../scripts/pet';
      import '../scripts/easter';
      import '../scripts/effects';
    </script>
  </body>
</html>
