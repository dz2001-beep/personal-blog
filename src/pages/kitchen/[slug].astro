---
/**
 * 菜品独立页(瑞士国际主义风格,与列表页同一套语言)
 * 用途:分享直链、搜索引擎收录、没有 JS 时的兜底入口。
 * 站内浏览默认走列表页的右侧面板(不跳页),这里是"单独打开一道菜"的情况。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import DishDetail from '../../components/DishDetail.astro';
import { DISHES, hasCover } from '../../data/kitchen';

const { slug } = Astro.params;
const index = DISHES.findIndex((d) => d.slug === slug);

if (index < 0) {
  return Astro.rewrite('/404');
}

const dish = DISHES[index]!;
const prev = index > 0 ? DISHES[index - 1] : undefined;
const next = index < DISHES.length - 1 ? DISHES[index + 1] : undefined;
const no = String(index + 1).padStart(2, '0');
---

<BaseLayout title={dish.name} description={dish.tagline || `${dish.name} 的做法与研究记录`}>
  <section class="swiss">
    <div class="wrap">
      <!-- 面包屑 -->
      <nav class="crumb">
        <a href="/kitchen"><span class="sq" aria-hidden="true"></span>← 返回下厨</a>
        <span class="crumb-no">No.{no}</span>
      </nav>

      <article class="sheet">
        <DishDetail dish={dish} hero={hasCover(dish)} variant="page" />
      </article>

      <nav class="pager">
        {prev ? <a href={`/kitchen/${prev.slug}/`} class="pager-link">← {prev.name}</a> : <span />}
        {next ? <a href={`/kitchen/${next.slug}/`} class="pager-link">{next.name} →</a> : <span />}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .swiss {
    background: #ffffff;
    color: #0a0a0a;
    min-height: calc(100vh - 60px);
    padding: 34px 0 72px;
  }

  .wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .sq {
    display: inline-block;
    width: 9px;
    height: 9px;
    background: #1e40ff;
    flex: 0 0 auto;
  }

  .crumb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e6e6e6;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .crumb a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #6f6f6f;
    text-decoration: none;
  }

  .crumb a:hover {
    color: #0a0a0a;
  }

  .crumb-no {
    color: #9b9b9b;
  }

  .sheet {
    margin-top: 26px;
    padding-top: 26px;
    border-top: 2px solid #0a0a0a;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    margin-top: 34px;
    padding-top: 18px;
    border-top: 1px solid #e6e6e6;
  }

  .pager-link {
    font-size: 0.84rem;
    font-weight: 500;
    color: #0a0a0a;
    text-decoration: none;
    border: 1px solid #0a0a0a;
    padding: 9px 15px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .pager-link:hover {
    background: #0a0a0a;
    color: #fff;
  }

  @media (max-width: 700px) {
    .wrap {
      padding: 0 18px;
    }
  }
</style>
