---
/**
 * 菜品行(瑞士国际主义风格)
 * - 不是卡片,而是一行:序号 / 方形缩略图 / 菜名 / 类型,行间用发丝线分隔
 * - 选中态用左侧 4px 蓝条 + 蓝色序号标记
 * - 保留 data-dish-* 钩子,交互逻辑不变
 */
import { coverOf, type Dish } from '../data/kitchen';

interface Props {
  dish: Dish;
  /** 序号(从 1 开始) */
  index: number;
}

const { dish, index } = Astro.props;
const cover = coverOf(dish);
const typeLabel = dish.type === 'cooked' ? '做过的' : '想学的';
const meta = [
  dish.date,
  dish.attempts ? `第 ${dish.attempts} 次` : '',
  dish.duration ? `${dish.duration}′` : '',
].filter(Boolean);
---

<a
  class="dish-row"
  href={`/kitchen/${dish.slug}/`}
  data-dish-card
  data-dish-slug={dish.slug}
  data-dish-type={dish.type}
  data-dish-name={dish.name}
  aria-label={`${dish.name} — ${typeLabel}`}
>
  <span class="row-idx">{String(index + 1).padStart(2, '0')}</span>

  <span class="row-thumb">
    {
      cover ? (
        <img src={cover} alt={dish.name} loading="lazy" decoding="async" />
      ) : (
        <span class="row-thumb-empty" />
      )
    }
  </span>

  <span class="row-body">
    <span class="row-name">{dish.name}</span>
    <span class="row-meta">{meta.join(' · ')}</span>
  </span>

  <span class="row-tag">{typeLabel}</span>
</a>

<style>
  .dish-row {
    position: relative;
    display: grid;
    grid-template-columns: 34px 92px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 13px 12px 13px 10px;
    border-top: 1px solid #e6e6e6;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .dish-row:last-child {
    border-bottom: 1px solid #e6e6e6;
  }

  .dish-row:hover {
    background: #f6f6f6;
  }

  /* 选中:左侧蓝条 + 淡蓝底 */
  .dish-row.is-active {
    background: #f2f4ff;
    box-shadow: inset 4px 0 0 #1e40ff;
  }

  .row-idx {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: #9b9b9b;
    letter-spacing: 0.04em;
  }

  .dish-row.is-active .row-idx {
    color: #1e40ff;
  }

  .row-thumb {
    display: block;
    width: 92px;
    height: 62px;
    overflow: hidden;
    background: #ededed;
  }

  .row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.12) contrast(1.02);
    transition: filter 0.3s ease, transform 0.4s ease;
  }

  .dish-row:hover .row-thumb img,
  .dish-row.is-active .row-thumb img {
    filter: grayscale(0) contrast(1.04);
    transform: scale(1.04);
  }

  .row-thumb-empty {
    display: block;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(45deg, #eee 0 6px, #e4e4e4 6px 12px);
  }

  .row-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .row-name {
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #0a0a0a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dish-row.is-active .row-name {
    font-weight: 700;
  }

  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: #8d8d8d;
  }

  .row-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: #6f6f6f;
    white-space: nowrap;
  }

  .dish-row.is-active .row-tag {
    color: #1e40ff;
    font-weight: 700;
  }

  @media (max-width: 560px) {
    .dish-row {
      grid-template-columns: 26px 68px minmax(0, 1fr);
      gap: 12px;
      padding: 12px 8px;
    }

    .row-thumb {
      width: 68px;
      height: 50px;
    }

    .row-tag {
      display: none;
    }
  }
</style>
