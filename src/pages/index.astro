---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import PostCard from '../components/PostCard.astro';
import WorkCard from '../components/WorkCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getPublishedPosts, getFeaturedWorks, getSiteConfig } from '../lib/db';

const site = getSiteConfig();
const posts = getPublishedPosts().slice(0, 4);
const works = getFeaturedWorks().slice(0, 6);

const socialButtons = [
  { href: site.social.github, label: 'GitHub', show: !!site.social.github },
  { href: site.social.juejin, label: '掘金', show: !!site.social.juejin },
  { href: site.social.twitter, label: 'Twitter', show: !!site.social.twitter },
  { href: site.social.email ? `mailto:${site.social.email}` : '', label: 'Email', show: !!site.social.email },
].filter((s) => s.show);
---

<BaseLayout>
  <!-- ============ Hero:头像紧贴左侧,信息在右 ============ -->
  <section class="hero">
    <div class="hero-inner fade-up">
      <Avatar size={150} alt={`${site.author} 的头像`} src={site.avatar} fallback={site.avatar} />
      <div class="hero-text">
        <h1 class="hero-title" id="hero-title">
          <span id="typed" data-text={site.heroTitle}></span><span class="typed-cursor">|</span>
        </h1>
        <p class="hero-tagline">
          <span class="hero-code">{'<'}dev{'>'}</span> {site.heroTagline}{' '}
          <span class="hero-code">{'</'}dev{'>'}</span>
        </p>
        <p class="hero-desc">{site.description}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/blog">📝 阅读文章</a>
          <a class="btn" href="/works">🚀 查看作品</a>
        </div>
        {
          socialButtons.length > 0 && (
            <div class="hero-social">
              {
                socialButtons.map((s) => (
                  <a class="btn social-btn" href={s.href} target="_blank" rel="noopener">{s.label}</a>
                ))
              }
            </div>
          )
        }
      </div>
    </div>
    <!-- 右侧装饰符号 -->
    <span class="hero-deco" aria-hidden="true">&lt;/&gt;</span>
  </section>

  <!-- ============ 主内容 + 侧栏 ============ -->
  <div class="layout-two">
    <div class="layout-main">
      <!-- 最近文章(双列网格) -->
      <section class="section">
        <h2 class="section-title">最近文章</h2>
        {
          posts.length > 0 ? (
            <div class="post-grid">
              {posts.map((post) => <PostCard post={post} />)}
            </div>
          ) : (
            <p class="empty">还没有文章,登录后台写第一篇吧!</p>
          )
        }
        <div class="section-more">
          <a class="btn" href="/blog">全部文章 →</a>
        </div>
      </section>

      <!-- 精选作品 -->
      <section class="section">
        <h2 class="section-title">精选作品</h2>
        {
          works.length > 0 ? (
            <div class="work-grid">
              {works.map((work) => <WorkCard work={work} />)}
            </div>
          ) : (
            <p class="empty">还没有作品,登录后台添加第一个作品吧!</p>
          )
        }
        <div class="section-more">
          <a class="btn" href="/works">全部作品 →</a>
        </div>
      </section>
    </div>

    <Sidebar />
  </div>
</BaseLayout>

<style>
  /* ---------- Hero:头像紧贴左侧 ---------- */
  .hero {
    position: relative;
    padding: 58px 0 46px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, var(--accent-soft), transparent 75%);
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    gap: 44px;
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero-text {
    max-width: 620px;
  }

  .hero-title {
    font-size: 2.4rem;
    margin: 0 0 8px;
    min-height: 1.3em;
    background: linear-gradient(120deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-tagline {
    margin: 0 0 10px;
    font-size: 1.05rem;
    color: var(--text);
    font-weight: 600;
  }

  .hero-code {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .hero-desc {
    margin: 0 0 22px;
    color: var(--text-dim);
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-social {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .social-btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 5px 12px;
    color: var(--text-dim);
  }

  .social-btn:hover {
    color: var(--accent);
  }

  /* 右侧装饰 */
  .hero-deco {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 11rem;
    font-weight: 700;
    color: rgba(37, 99, 235, 0.06);
    pointer-events: none;
    user-select: none;
    line-height: 1;
  }

  /* ---------- 主区 ---------- */
  .section {
    margin-top: 46px;
  }

  .layout-main .section:first-child {
    margin-top: 0;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 14px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .section-more {
    margin-top: 20px;
    text-align: center;
  }

  .empty {
    color: var(--text-dim);
    padding: 24px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    text-align: center;
  }

  /* ---------- 响应式 ---------- */
  @media (max-width: 640px) {
    .hero {
      padding: 36px 0 30px;
    }
    .hero-inner {
      gap: 18px;
      padding: 0 16px;
    }
    .hero-inner .avatar {
      width: 92px !important;
      height: 92px !important;
    }
    .hero-title {
      font-size: 1.5rem;
    }
    .hero-desc {
      font-size: 0.9rem;
    }
    .hero-actions {
      gap: 8px;
    }
    .hero-deco {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .hero-inner {
      gap: 12px;
    }
    .hero-actions .btn {
      padding: 8px 12px;
      font-size: 0.85rem;
    }
  }
</style>
